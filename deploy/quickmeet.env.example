# quickmeet's environment on a single box: copy to /etc/quickmeet/env,
# fill in LIVEKIT_API_SECRET and ALLOWED_EMAILS, and keep it readable by
# root only (chmod 600). See docs/INSTALL.md.

# The app's http port, on loopback: Caddy on the same box is the only thing
# that should reach it. With 8080 closed to the outside, the address Caddy
# forwards is the one the rate limits trust.
PORT=8080
HOST=127.0.0.1

# The sqlite file; the unit's StateDirectory creates /var/lib/quickmeet.
DB_PATH=/var/lib/quickmeet/quickmeet.db

# The SFU. Signalling stays on loopback (Caddy exposes it as wss:// on
# /rtc); media goes straight to the box on these two ports, which the
# firewall must open.
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
# Advertise the box's public address, found over STUN, to browsers.
LIVEKIT_USE_EXTERNAL_IP=true

# Token signing. The key is any short name; the secret must be 32 or more
# random characters, and the app refuses to start without one here:
#   openssl rand -hex 32
LIVEKIT_API_KEY=quickmeet
LIVEKIT_API_SECRET=

LIVEKIT_LOG_LEVEL=info

# Who may have an account, comma-separated. Empty means anyone who finds the
# site can sign up and start calls on your bandwidth.
ALLOWED_EMAILS=
