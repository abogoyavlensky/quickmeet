# Caddy in front of quickmeet on the same box: TLS for the domain,
# compression, the SFU's signalling WebSocket on /rtc*, everything else to
# the app.
# Replace meet.example.com with your domain. See docs/INSTALL.md.
meet.example.com {
	# The app serves raw bytes; background blur's wasm is 9.4 MB of them.
	encode zstd gzip
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
