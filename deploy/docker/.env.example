# Settings for deploy/docker/compose.yaml: copy to .env next to it and fill
# in. See docs/INSTALL.md.

# The name browsers use, pointing at this server. Caddy gets its
# certificate on the first start.
QUICKMEET_DOMAIN=meet.example.com

# Who may have an account, comma-separated. Empty means anyone who finds the
# site can sign up and start calls on your bandwidth.
ALLOWED_EMAILS=

# Token signing: 32 or more random characters. The app refuses to start
# without one:
#   openssl rand -hex 32
LIVEKIT_API_SECRET=

# Pin a release (0.1.0) instead of the latest one.
#QUICKMEET_VERSION=latest
