{:paths ["src"]
 ;; resources/public holds the pages; lgx build embeds them into the binary.
 :resource-paths ["resources"]
 :main "main.lg"

 ;; The sqlite driver and the LiveKit server are Go packages, so this app
 ;; runs on an lg that lgx builds from :lg-version with the Go toolchain.
 ;; Needs lgx 0.4.2 or newer: :go/replace (for LiveKit's pion forks) and the
 ;; :go/local content stamp (so runs after the first are cache hits).
 :lg-runtime :built
 :lg-version "1.13.0"

 :targets {:bin {:out "bin/quickmeet"}}

 :deps {;; The embedded SFU, join tokens and webhook verification.
        abogoyavlensky/letgo-livekit
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "livekit-v0.1.1"
         :deps/root "livekit"}

        ;; sqlite over Go's database/sql; brings the sql layer and the
        ;; modernc.org/sqlite driver in transitively.
        abogoyavlensky/letgo-sqlite
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "sqlite-v0.2.0"
         :deps/root "sqlite"}

        ;; Migrations: a ragtime DataStore and Migration over the sql layer.
        abogoyavlensky/letgo-ragtime
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "ragtime-v0.2.0"
         :deps/root "ragtime"}

        ;; SQL as data: (sql/format {...}) -> [sql & params].
        com.github.seancorfield/honeysql
        {:git/url "https://github.com/seancorfield/honeysql"
         :git/tag "v2.7.1479"}

        ;; integrant wires db, livekit, handler and server. It depends on
        ;; weavejester/dependency; lgx does not read a plain Clojure lib's
        ;; deps.edn transitively, so both are listed (the livekit package
        ;; names the same coords).
        dev.weavejester/dependency
        {:git/url "https://github.com/weavejester/dependency"
         :git/tag "1.0.1"}
        dev.weavejester/integrant
        {:git/url "https://github.com/weavejester/integrant"
         :git/tag "1.0.1"}

        ;; Routing.
        askonomm/ruuter
        {:git/url "https://git.nmm.ee/asko/ruuter"
         :git/tag "v2.1.1"}

        ;; Password hashing, generated bindings and no shim: a let-go string
        ;; crosses as []byte and the hash comes back as a string. The alias
        ;; must be the package path's last segment. livekit-server already
        ;; pulls this module in, so the pin stays within the graph it uses.
        golang.org/x/crypto/bcrypt {:go/version "v0.56.0" :go/interop "bcrypt"}}

 :tasks
 {;; Browser tests: build the binary that ships, then let Playwright start it
  ;; on test ports and drive two headless Chromiums through a real call.
  ;; See e2e/playwright.config.js and "Browser tests" in the README.
  e2e
  {:doc "Build the binary and run the browser tests against it"
   :do [{:task lgx:build}
        {:sh "cd e2e && npx playwright test"}]}

  ;; A two-browser call against any running instance, for a check after an
  ;; install or to see what a deploy does to a live call. Reads QM_URL,
  ;; QM_EMAIL, QM_PASSWORD, QM_SIGNUP and QM_SECS; see e2e/smoke.mjs.
  smoke
  {:doc "Hold a two-browser call against QM_URL and report what happened"
   :do {:sh "cd e2e && node smoke.mjs"}}

  e2e-setup
  {:doc "Install the e2e dependencies and the headless browser"
   :do {:sh "cd e2e && npm ci && npx playwright install chromium-headless-shell"}}

  ;; The browser side of LiveKit, served from the binary rather than a CDN.
  ;; The version is pinned here and in docs/KNOWLEDGE.md; bump both.
  vendor-livekit-client
  {:doc "Download the pinned livekit-client UMD build into resources/public"
   :do {:sh "curl -fsSL https://cdn.jsdelivr.net/npm/livekit-client@2.22.3/dist/livekit-client.umd.min.js -o resources/public/livekit-client.umd.min.js"}}}}
