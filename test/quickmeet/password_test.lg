(ns quickmeet.password-test
  (:require [clojure.test :refer [deftest is]]
            [quickmeet.password :as password]
            [string :as str]))

(deftest hashes-are-salted-and-checkable
  (let [h (password/hash "correct horse")]
    (is (str/starts-with? h "$2a$10$"))
    (is (not= h (password/hash "correct horse")))
    (is (password/check h "correct horse"))
    (is (not (password/check h "wrong")))
    (is (not (password/check "not a hash" "correct horse")))))

(deftest the-limit-is-72-bytes
  ;; bcrypt reads at most 72 bytes; "é" is two, so 36 of them fill it.
  (let [pw (apply str (repeat 36 "é"))
        h (password/hash pw)]
    (is (password/check h pw))
    (is (not (password/check h (apply str (repeat 35 "é")))))))

(deftest the-dummy-hash-is-a-real-cost-10-hash
  ;; So a dummy check costs what a real one does.
  (is (str/starts-with? password/dummy-hash "$2a$10$"))
  (is (password/check password/dummy-hash "quickmeet-dummy-password"))
  (is (false? (password/dummy-check "quickmeet-dummy-password")))
  (is (false? (password/dummy-check "anything"))))
