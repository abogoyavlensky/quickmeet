(ns quickmeet.migrations-test
  (:require [clojure.test :refer [deftest is]]
            [quickmeet.migrations :as migrations]
            [ragtime.letgo :as rt]
            [ragtime.protocols :as p]
            [sqlite.core :as sqlite]))

;; The migration history against a throwaway sqlite file: up, up again (a
;; no-op), then down, checking what sqlite itself reports.

(defn- with-conn [f]
  (let [path (str "/tmp/quickmeet-migrations-" (rand-int 100000000) ".db")
        conn (sqlite/open path)]
    (try
      (f conn)
      (finally
        (sqlite/close! conn)
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))

(defn- tables [conn]
  (mapv :name (sqlite/query conn ["select name from sqlite_master
                                   where type = 'table' and name not like 'sqlite_%'
                                   order by name"])))

(defn- applied [conn]
  (p/applied-migration-ids (migrations/store conn)))

(defn- columns [conn table]
  (mapv :name (sqlite/query conn [(str "select name from pragma_table_info('" table "')")])))

(deftest migrate-up-and-down
  (with-conn
    (fn [conn]
      (is (= [] (applied conn)))
      (migrations/migrate! conn)
      (is (= ["001-create-rooms" "002-create-users" "003-rooms-members-calls"] (applied conn)))
      (is (= ["call_participants" "calls" "ragtime_migrations" "room_members" "rooms" "sessions" "users"]
             (tables conn)))
      (is (= ["id" "created_at" "owner_id" "name"] (columns conn "rooms")))
      (migrations/migrate! conn)
      (is (= 3 (count (applied conn))))
      ;; Two steps back: the accounts go, the rooms stay, without their owner.
      (migrations/rollback! conn 2)
      (is (= ["001-create-rooms"] (applied conn)))
      (is (= ["ragtime_migrations" "rooms"] (tables conn)))
      (is (= ["id" "created_at"] (columns conn "rooms")))
      (migrations/rollback! conn)
      (is (= [] (applied conn)))
      (is (= ["ragtime_migrations"] (tables conn))))))

(deftest rooms-survive-migration-002-both-ways
  ;; A database from before M3 holds rooms. Migration 002 adds their owner
  ;; column, and rolling it back drops the column again: the rooms and
  ;; their ids come through both.
  (with-conn
    (fn [conn]
      (rt/migrate {:datastore (migrations/store conn)
                   :migrations [(first migrations/migrations)]})
      (sqlite/execute! conn ["insert into rooms (id) values ('aaaaaaaaaaaa'), ('bbbbbbbbbbbb')"])
      (rt/migrate {:datastore (migrations/store conn)
                   :migrations (vec (take 2 migrations/migrations))})
      (is (= ["id" "created_at" "owner_id"] (columns conn "rooms")))
      (is (= [{:id "aaaaaaaaaaaa" :owner_id nil} {:id "bbbbbbbbbbbb" :owner_id nil}]
             (sqlite/query conn ["select id, owner_id from rooms order by id"])))
      (migrations/rollback! conn)
      (is (= ["id" "created_at"] (columns conn "rooms")))
      (is (= [{:id "aaaaaaaaaaaa"} {:id "bbbbbbbbbbbb"}]
             (sqlite/query conn ["select id from rooms order by id"]))))))

(deftest migration-003-both-ways
  ;; A database from M3 holds a user and their room. Migration 003 names
  ;; rooms, records members (backfilling every owner as one) and adds the
  ;; history tables; rolling it back drops all of that and keeps the rooms.
  (with-conn
    (fn [conn]
      (rt/migrate {:datastore (migrations/store conn)
                   :migrations (vec (take 2 migrations/migrations))})
      (sqlite/execute! conn ["insert into users (id, email, password_hash, display_name)
                              values ('u1', 'a@b.c', 'x', 'a')"])
      (sqlite/execute! conn ["insert into rooms (id, owner_id) values ('aaaaaaaaaaaa', 'u1'), ('bbbbbbbbbbbb', null)"])
      (migrations/migrate! conn)
      (is (= ["001-create-rooms" "002-create-users" "003-rooms-members-calls"] (applied conn)))
      (is (= ["call_participants" "calls" "ragtime_migrations" "room_members" "rooms" "sessions" "users"]
             (tables conn)))
      (is (= ["id" "created_at" "owner_id" "name"] (columns conn "rooms")))
      ;; The owner is a member; the ownerless room has none.
      (is (= [{:room_id "aaaaaaaaaaaa" :user_id "u1"}]
             (sqlite/query conn ["select room_id, user_id from room_members"])))
      (sqlite/execute! conn ["update rooms set name = 'Mom' where id = 'aaaaaaaaaaaa'"])
      (sqlite/execute! conn ["insert into calls (id, room_id, sid) values ('c1', 'aaaaaaaaaaaa', 'RM_1')"])
      (sqlite/execute! conn ["insert into call_participants (sid, call_id, user_id, name, joined_at)
                              values ('PA_1', 'c1', 'u1', 'a', '2026-09-30 10:00:00')"])
      (migrations/rollback! conn)
      (is (= ["001-create-rooms" "002-create-users"] (applied conn)))
      (is (= ["ragtime_migrations" "rooms" "sessions" "users"] (tables conn)))
      (is (= ["id" "created_at" "owner_id"] (columns conn "rooms")))
      (is (= [{:id "aaaaaaaaaaaa" :owner_id "u1"} {:id "bbbbbbbbbbbb" :owner_id nil}]
             (sqlite/query conn ["select id, owner_id from rooms order by id"])))
      (migrations/migrate! conn)
      (is (= 3 (count (applied conn)))))))
