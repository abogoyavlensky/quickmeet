(ns quickmeet.system-test
  (:require [clojure.test :refer [deftest is]]
            [hash :as hash]
            [http :as http]
            [json :as json]
            [livekit.core :as lk]
            [integrant.core :as ig]
            [quickmeet.db :as db]
            [quickmeet.sfu :as sfu]
            [sqlite.core :as sqlite]
            [quickmeet.system :as system]
            [string :as str]))

;; The whole system: a throwaway database, the http server on a free port,
;; and the SFU on its own test ports. Requests go through the real server,
;; the token is checked against the real SFU's room API, and halting the
;; system stops both servers.

(def ^:private lk-port 7890)

(defn- with-system
  ([f] (with-system identity f))
  ([adjust f]
  (let [path (str "/tmp/quickmeet-system-" (rand-int 100000000) ".db")
        system (system/start! (-> (system/config)
                                  (assoc-in [:quickmeet.db/conn :path] path)
                                  (assoc-in [:quickmeet.server/http :addr] "127.0.0.1:0")
                                  (assoc-in [:livekit/server :config :port] lk-port)
                                  (assoc-in [:livekit/server :config :rtc :tcp_port] 7891)
                                  (assoc-in [:quickmeet.routes/handler :livekit :port] lk-port)
                                  adjust))]
    (try
      (f system (str "http://" (:addr (:quickmeet.server/http system))))
      (finally
        (system/stop! system)
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm")))))))

(defn- json-body [res]
  (json/read-json (:body res) {:keywords? true}))

(defn- post-json [url body & [headers]]
  (http/post url (json/write-json body) {:content-type "application/json"
                                         :headers (or headers {})}))

(defn- signup
  "Sign a fresh address up over http; the request headers that carry its
   session cookie. let-go's client lowercases response header names."
  [base]
  (let [res (post-json (str base "/api/auth/signup")
                       {:email (str "user" (rand-int 100000000) "@example.com")
                        :password "correct horse"})
        cookie (second (re-find #"^session=([^;]*)" (str (get-in res [:headers "set-cookie"]))))]
    {"Cookie" (str "session=" cookie)}))

(deftest pages-rooms-and-tokens-over-http
  (with-system
    (fn [system base]
      (is (lk/running? (:livekit/server system)))
      (is (= 200 (:status (http/get (str base "/")))))
      (let [id (:id (json-body (http/post (str base "/api/rooms") "" {:headers (signup base)})))
            tok (json-body (http/post (str base "/api/rooms/" id "/token")
                                      "{\"identity\":\"alice\"}"
                                      {:content-type "application/json"}))]
        (is (= 12 (count id)))
        ;; Nobody has joined, so the SFU has no such room yet: no participants.
        (is (= [] (:participants (json-body (http/get (str base "/api/rooms/" id))))))
        (is (str/starts-with? (:token tok) "eyJ"))
        (is (= (str "ws://127.0.0.1:" lk-port) (:url tok)))
        ;; Behind a TLS proxy the host the request came in on is kept
        ;; whole: the proxy routes /rtc on it to the SFU.
        (is (= (str "wss://" (subs base (count "http://")))
               (:url (json-body (http/post (str base "/api/rooms/" id "/token")
                                           "{}"
                                           {:content-type "application/json"
                                            :headers {"X-Forwarded-Proto" "https"}})))))
        ;; The SFU accepts the token this app minted: /rtc/validate is the
        ;; check livekit-client itself uses to diagnose a join, and answers
        ;; 200 "success" only for a token this SFU will let into the room.
        (let [res (http/get (str "http://127.0.0.1:" lk-port
                                 "/rtc/validate?access_token=" (:token tok)))]
          (is (= 200 (:status res)) (str "SFU rejected the token: " (:body res)))
          (is (= "success" (:body res))))))))

(deftest participants-of-an-unknown-room
  ;; The SFU creates a room on its first join, so a room the app knows but
  ;; nobody has joined is unknown to the SFU: an empty vector, not nil.
  ;; Likewise the SFU has no active rooms at all: an empty map, not nil.
  (with-system
    (fn [_ _]
      (let [livekit {:api-key system/dev-api-key
                     :api-secret system/dev-api-secret
                     :port lk-port}]
        (is (= [] (sfu/participants livekit "0123456789ab")))
        (is (= {} (sfu/active-rooms livekit)))
        ;; A room the SFU has (created here by the room API) is listed with
        ;; its count; the field is num_participants, and twirp emits it
        ;; even at zero.
        (sfu/create-room! livekit "0123456789ab")
        (is (= {"0123456789ab" 0} (sfu/active-rooms livekit)))
        (is (= [] (sfu/participants livekit "0123456789ab")))
        ;; An SFU that is not there: nil for both.
        (is (nil? (sfu/participants (assoc livekit :port 1) "0123456789ab")))
        (is (nil? (sfu/active-rooms (assoc livekit :port 1))))))))

(def ^:private real-secret "a-real-secret-a-real-secret-a-real-secret")

(defn- config-from [m]
  (system/config (fn [name] (get m name))))

(defn- refused?
  "Whether config refuses `m`, naming the variable to set."
  [m]
  (try (config-from m) false
       (catch Exception e (str/includes? (str (ex-message e)) "LIVEKIT_API_SECRET"))))

(deftest config-from-the-environment
  ;; Nothing set: the media port range, and the URL derived per request.
  (let [c (config-from {})
        rtc (get-in c [:livekit/server :config :rtc])]
    ;; The SFU posts its events back to this app, on PORT.
    (is (= {:api_key "devkey" :urls ["http://127.0.0.1:8080/api/webhooks/livekit"]}
           (get-in c [:livekit/server :config :webhook])))
    (is (= ["http://127.0.0.1:8099/api/webhooks/livekit"]
           (get-in (config-from {"PORT" "8099"}) [:livekit/server :config :webhook :urls])))
    (is (= 50000 (:port_range_start rtc)))
    (is (= 50100 (:port_range_end rtc)))
    (is (not (contains? rtc :udp_port)))
    (is (nil? (get-in c [:quickmeet.routes/handler :livekit :public-url])))
    ;; Two people per room: the SFU enforces the product rule.
    (is (= 2 (get-in c [:livekit/server :config :room :max_participants])))
    ;; No allowlist: open sign-up.
    (is (nil? (get-in c [:quickmeet.routes/handler :auth :allowed-emails]))))
  ;; An allowlist, however it is spaced and cased; blank means unset.
  (is (= #{"a@b.com" "c@d.org"}
         (get-in (config-from {"ALLOWED_EMAILS" " A@b.com, c@d.org ,"})
                 [:quickmeet.routes/handler :auth :allowed-emails])))
  (is (nil? (get-in (config-from {"ALLOWED_EMAILS" "  "})
                    [:quickmeet.routes/handler :auth :allowed-emails])))
  ;; A container: one multiplexed UDP port, reachable from the proxy.
  (let [c (config-from {"LIVEKIT_UDP_PORT" "7882"
                        "LIVEKIT_PUBLIC_URL" "wss://quickmeet.absky.dev"
                        "LIVEKIT_BIND" "0.0.0.0"
                        "LIVEKIT_API_SECRET" real-secret})
        rtc (get-in c [:livekit/server :config :rtc])]
    (is (= 7882 (:udp_port rtc)))
    (is (not (contains? rtc :port_range_start)))
    (is (not (contains? rtc :port_range_end)))
    (is (= ["0.0.0.0"] (get-in c [:livekit/server :config :bind_addresses])))
    (is (= "wss://quickmeet.absky.dev"
           (get-in c [:quickmeet.routes/handler :livekit :public-url])))))

(deftest concurrent-sign-up-of-one-address
  ;; Two requests race to register the same address: the unique index
  ;; refuses one of them, and that must read as 409, never a 500.
  (with-system
    (fn [_ base]
      (let [body {:email "race@example.com" :password "correct horse"}
            results (->> (range 8)
                         (mapv (fn [_] (future (post-json (str base "/api/auth/signup") body))))
                         (mapv deref))
            statuses (frequencies (map :status results))]
        (is (= {201 1 409 7} statuses)
            (str "bodies: " (->> results (map :body) distinct (take 3) vec)))))))

(deftest rooms-need-an-account-over-http
  (with-system
    (fn [_ base]
      (is (= 401 (:status (http/post (str base "/api/rooms") "" {}))))
      (is (= 201 (:status (http/post (str base "/api/rooms") "" {:headers (signup base)}))))
      ;; The cookie the server sets is the one a browser would send back.
      (let [res (post-json (str base "/api/auth/signup")
                           {:email "over-http@example.com" :password "correct horse"})]
        (is (= 201 (:status res)))
        (is (re-find #"^session=[0-9a-f]{32}; Path=/; HttpOnly; SameSite=Lax; Max-Age=31536000$"
                     (str (get-in res [:headers "set-cookie"]))))))))

(deftest concurrent-room-creation
  ;; Every request runs on its own goroutine and the pool hands each its own
  ;; sqlite connection, so simultaneous creations race for the write lock.
  ;; All of them must succeed, with distinct ids.
  (with-system
    (fn [_ base]
      (let [session (signup base)
            results (->> (range 40)
                         (mapv (fn [_] (future (http/post (str base "/api/rooms") "" {:headers session}))))
                         (mapv deref))
            statuses (frequencies (map :status results))]
        (is (= {201 40} statuses)
            (str "failures: " (->> results (remove #(= 201 (:status %)))
                                   (map :body) distinct (take 3) vec)))
        (is (= 40 (count (set (keep #(when (= 201 (:status %)) (:id (json-body %)))
                                    results)))))))))

(deftest halt-releases-the-ports
  (let [base (with-system (fn [system base]
                            (is (pos? (:port (:quickmeet.server/http system))))
                            base))]
    (is (thrown? Exception (http/get (str base "/"))))
    (is (thrown? Exception (http/get (str "http://127.0.0.1:" lk-port "/"))))))

;; The app on a fixed port, since the SFU's config must name it up front.
(def ^:private app-port 8090)

(defn- signed-webhook [body]
  {"Authorization" (lk/token system/dev-api-key system/dev-api-secret
                             {:sha256 (io/encode :base64 (io/decode :hex (hash/sha256 body)))})})

(deftest webhooks-reach-the-app
  (with-system
    (fn [c] (-> c
                (assoc-in [:quickmeet.server/http :addr] (str "127.0.0.1:" app-port))
                (assoc-in [:livekit/server :config :webhook :urls]
                          [(str "http://127.0.0.1:" app-port "/api/webhooks/livekit")])))
    (fn [_ base]
      (let [cookie (signup base)
            id (:id (json-body (http/post (str base "/api/rooms") "" {:headers cookie})))
            user-id (:identity (json-body (http/post (str base "/api/rooms/" id "/token") "{}"
                                                     {:content-type "application/json" :headers cookie})))
            joined (json/write-json {:event "participant_joined" :room {:name id :sid "RM_test"}
                                     :createdAt "1000"
                                     :participant {:sid "PA_1" :identity user-id :name "Alice" :joinedAt "1000"}})
            hook (str base "/api/webhooks/livekit")
            calls (fn [] (:items (json-body (http/get (str base "/api/calls") {:headers cookie}))))]
        ;; Over real HTTP, with the real verification: unsigned refused,
        ;; signed recorded.
        (is (= 401 (:status (http/post hook joined {:content-type "application/json"}))))
        (is (= 200 (:status (http/post hook joined {:content-type "application/json"
                                                    :headers (signed-webhook joined)}))))
        (is (= 1 (count (calls))))
        (is (nil? (:ended_at (first (calls)))))
        ;; And from the SFU itself: closing a room it has makes it post
        ;; room_finished, which ends the open call for that room id.
        (let [livekit {:api-key system/dev-api-key :api-secret system/dev-api-secret :port lk-port}]
          (sfu/create-room! livekit id)
          (sfu/delete-room! livekit id)
          (loop [tries 50]
            (when (and (nil? (:ended_at (first (calls)))) (pos? tries))
              (sleep 100)
              (recur (dec tries))))
          (is (some? (:ended_at (first (calls)))) "room_finished never arrived from the SFU"))))))

(deftest sign-in-is-rate-limited-over-http
  ;; The eleventh attempt from one address within a minute is refused,
  ;; right or wrong, through the real server and the real limiter.
  (with-system
    (fn [_ base]
      (let [attempt #(post-json (str base "/api/auth/signin")
                                {:email "nobody@example.com" :password "wrong password"})
            statuses (mapv (fn [_] (:status (attempt))) (range 11))]
        (is (= (repeat 10 401) (take 10 statuses)))
        (is (= 429 (last statuses)))))))

(deftest rate-limits-can-be-switched-off
  (is (true? (get-in (system/config {}) [:quickmeet.routes/handler :rate-limit?])))
  (is (false? (get-in (system/config {"RATE_LIMIT" "false"}) [:quickmeet.routes/handler :rate-limit?])))
  (with-system #(assoc-in % [:quickmeet.routes/handler :rate-limit?] false)
    (fn [_ base]
      (is (every? #(= 401 %)
                  (mapv (fn [_] (:status (post-json (str base "/api/auth/signin")
                                                    {:email "nobody@example.com" :password "wrong password"})))
                        (range 12)))))))

(deftest the-development-secret-is-refused-once-exposed
  ;; A laptop: nothing set, or loopback spelled either way.
  (is (not (refused? {})))
  (is (not (refused? {"LIVEKIT_BIND" "localhost"})))
  (is (not (refused? {"LIVEKIT_BIND" "127.0.0.1"})))
  ;; Anything that means other machines can reach the SFU, with the
  ;; well-known secret: refused, whether unset or set to it explicitly.
  (is (refused? {"LIVEKIT_BIND" "0.0.0.0"}))
  (is (refused? {"LIVEKIT_USE_EXTERNAL_IP" "true"}))
  (is (refused? {"LIVEKIT_PUBLIC_URL" "wss://meet.example"}))
  (is (refused? {"LIVEKIT_BIND" "0.0.0.0" "LIVEKIT_API_SECRET" system/dev-api-secret}))
  ;; The same with a secret of the operator's own.
  (doseq [m [{"LIVEKIT_BIND" "0.0.0.0"}
             {"LIVEKIT_USE_EXTERNAL_IP" "true"}
             {"LIVEKIT_PUBLIC_URL" "wss://meet.example"}]]
    (is (map? (config-from (assoc m "LIVEKIT_API_SECRET" real-secret))))))

(deftest host-sets-the-bind-address
  (is (= "127.0.0.1:9000" (get-in (config-from {"HOST" "127.0.0.1" "PORT" "9000"})
                                  [:quickmeet.server/http :addr])))
  (is (= ":9000" (get-in (config-from {"PORT" "9000"}) [:quickmeet.server/http :addr])))
  (is (= "0.0.0.0:9000" (get-in (config-from {"HOST" "0.0.0.0" "PORT" "9000"})
                                [:quickmeet.server/http :addr])))
  ;; Any other address would leave the SFU's webhooks nowhere to go.
  (doseq [host ["10.0.0.5" "localhost" "::1"]]
    (is (= "HOST" (try (config-from {"HOST" host}) nil
                       (catch Exception e (:variable (ex-data e)))))
        host)))

(deftest shutdown-stops-serving-closes-history-and-keeps-the-sfu
  ;; Not through with-system: this test owns the teardown, since shutdown!
  ;; leaves the SFU for the process exit to take down.
  (let [path (str "/tmp/quickmeet-system-" (rand-int 100000000) ".db")
        system (system/start! (-> (system/config)
                                  (assoc-in [:quickmeet.db/conn :path] path)
                                  (assoc-in [:quickmeet.server/http :addr] "127.0.0.1:0")
                                  (assoc-in [:livekit/server :config :port] lk-port)
                                  (assoc-in [:livekit/server :config :rtc :tcp_port] 7891)
                                  (assoc-in [:quickmeet.routes/handler :livekit :port] lk-port)))
        base (str "http://" (:addr (:quickmeet.server/http system)))
        livekit (get-in (system/config) [:quickmeet.routes/handler :livekit])
        livekit (assoc livekit :port lk-port)
        conn (:quickmeet.db/conn system)]
    (try
      (db/create-user! conn "u-1" "one@example.com" "x" "One")
      (db/create-room! conn "0123456789ab" "u-1")
      (db/create-call! conn "c-1" "0123456789ab" "RM_1")
      (is (= 200 (:status (http/get (str base "/")))))
      (system/shutdown! system)
      (is (= :refused (try (http/get (str base "/")) (catch Exception _ :refused)))
          "the app no longer serves")
      (is (map? (sfu/active-rooms livekit)) "the SFU is still up")
      (let [c (sqlite/open path)]
        (try
          (is (some? (:ended_at (sqlite/execute-one! c ["select ended_at from calls where id = ?" "c-1"]))))
          (finally (sqlite/close! c))))
      (finally
        (ig/halt! system [:livekit/server])
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))
