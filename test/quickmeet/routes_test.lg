(ns quickmeet.routes-test
  (:require [clojure.test :refer [deftest is]]
            [integrant.core :as ig]
            [hash :as hash]
            [json :as json]
            [livekit.core :as lk]
            [quickmeet.db]
            [quickmeet.history :as history]
            [quickmeet.routes :as routes]
            [sqlite.core :as sqlite]
            [string :as str]))

;; The handler as a plain function over a throwaway sqlite file: integrant
;; starts only the db component. No http server and no SFU: minting a token
;; needs the key and secret only.

(def ^:private livekit {:api-key "devkey"
                        :api-secret "test-secret-test-secret-test-secret!!"
                        :port 7880})

(def ^:private anyone {:allowed-emails nil})

(defn- verify [header body]
  (lk/verify-webhook header body (:api-key livekit) (:api-secret livekit)))

(def ^:private nobody-anywhere
  {:participants (constantly []) :active-rooms (constantly {}) :verify verify})

;; A webhook as the SFU signs it: a JWT from the app's key whose sha256
;; claim is the base64 SHA-256 of the raw body. hash/sha256 gives hex, and
;; a let-go string holds raw bytes, so the claim is a decode and an encode.
(defn- signed-webhook
  ([body] (signed-webhook body (:api-secret livekit)))
  ([body secret]
   {:headers {"authorization" (lk/token (:api-key livekit) secret
                                        {:sha256 (io/encode :base64 (io/decode :hex (hash/sha256 body)))})
              "content-type" "application/json"}}))

;; The handler's push service, with nothing leaving the machine: sends are
;; recorded in `sent` as [target message] and answer `status`, and spawning
;; runs at once, so a test sees a ring's sends when the response is back.
(defn- recording-push
  ([sent] (recording-push sent 201))
  ([sent status]
   {:public-key "test-public-key"
    :send! (fn [target message] (swap! sent conj [target message]) status)
    :spawn (fn [f] (f))}))

;; `lookups` is the handler's map of SFU questions, or just the
;; :participants function for the tests that only care about one room.
(defn- with-handler
  ([f] (with-handler livekit f))
  ([lk f] (with-handler lk nobody-anywhere f))
  ([lk lookups f] (with-handler lk lookups anyone f))
  ([lk lookups auth f] (with-handler lk lookups auth (recording-push (atom [])) f))
  ([lk lookups auth push f]
   (let [path (str "/tmp/quickmeet-routes-" (rand-int 100000000) ".db")
         system (ig/init {:quickmeet.db/conn {:path path}})
         lookups (if (fn? lookups) (assoc nobody-anywhere :participants lookups) lookups)]
     (try
       (f (routes/handler (:quickmeet.db/conn system) lk lookups auth push)
          (:quickmeet.db/conn system))
       (finally
         (ig/halt! system)
         (os/sh "rm" "-f" path (str path "-wal") (str path "-shm")))))))

(defn- call
  ([handler method uri] (call handler method uri nil))
  ([handler method uri body] (call handler method uri body nil))
  ([handler method uri body extra]
   (let [res (handler (-> {:request-method method
                           :uri uri
                           :server-addr "meet.example:8080"
                           :body body}
                          (merge extra)
                          ;; A body is JSON unless the test says otherwise,
                          ;; as the pages and the http client send it.
                          (assoc :headers (merge (when body {"content-type" "application/json"})
                                                 (:headers extra)))))]
     (assoc res :json (when (and (seq (:body res))
                                 (= "application/json"
                                    (get-in res [:headers "Content-Type"])))
                        (json/read-json (:body res) {:keywords? true}))))))

(defn- cookie-of
  "The session id a response's Set-Cookie carries."
  [res]
  (second (re-find #"^session=([^;]*)" (str (get-in res [:headers "Set-Cookie"])))))

(defn- signup
  "Sign `email` up with a fixed password; the response plus its :cookie."
  ([handler] (signup handler (str "user" (rand-int 100000000) "@example.com")))
  ([handler email]
   (let [res (call handler :post "/api/auth/signup"
                   (json/write-json {:email email :password "correct horse"}))]
     (assoc res :cookie (cookie-of res)))))

(defn- as
  "Request extras that carry a session cookie."
  [cookie]
  {:headers {"cookie" (str "session=" cookie)}})

(defn- listed
  "The items on the first page of a list endpoint, as `cookie`'s user."
  [handler uri cookie]
  (:items (:json (call handler :get uri nil (as cookie)))))

(defn- new-room
  "A room made by a freshly signed-up user; its id."
  [handler]
  (:id (:json (call handler :post "/api/rooms" nil (as (:cookie (signup handler)))))))

(deftest room-ids-are-short-hex
  (let [id (routes/new-room-id)]
    (is (= 12 (count id)))
    (is (re-find #"^[0-9a-f]{12}$" id))
    (is (not= id (routes/new-room-id)))))

(deftest create-room-then-join
  (with-handler
    (fn [handler _]
      (let [created (call handler :post "/api/rooms" nil (as (:cookie (signup handler))))
            id (:id (:json created))]
        (is (= 201 (:status created)))
        (is (= 12 (count id)))
        (is (= id (:id (:json (call handler :get (str "/api/rooms/" id))))))
        (let [tok (call handler :post (str "/api/rooms/" id "/token")
                        "{\"identity\":\"alice\"}")]
          (is (= 200 (:status tok)))
          ;; A guest: a random identity, the typed name.
          (is (re-find #"^guest:[0-9a-f]{4}$" (:identity (:json tok))))
          (is (= "alice" (:name (:json tok))))
          ;; A JWT: three base64url segments, HS256 header.
          (is (str/starts-with? (:token (:json tok)) "eyJ"))
          (is (= 3 (count (str/split (:token (:json tok)) "."))))
          ;; The signalling URL is the host the page was served from, at
          ;; the SFU's port.
          (is (= "ws://meet.example:7880" (:url (:json tok)))))
        ;; No name: a guest name is invented.
        (let [tok (call handler :post (str "/api/rooms/" id "/token") "{}")]
          (is (str/starts-with? (:name (:json tok)) "guest-")))
        ;; Signed in: the account is the identity, the display name the name,
        ;; whatever was typed.
        (let [{:keys [cookie json]} (signup handler "carol@example.com")
              tok (call handler :post (str "/api/rooms/" id "/token")
                        "{\"identity\":\"someone else\"}" (as cookie))]
          (is (str/starts-with? (:identity (:json tok)) "user:"))
          (is (= (:display_name json) (:name (:json tok)))))))))

(defn- signalling-url-for
  "The :url a token response carries, for a handler over `lk` and a request
   with `extra` keys (:server-addr, :headers)."
  [lk extra]
  (with-handler lk
    (fn [handler _]
      (let [id (new-room handler)]
        (:url (:json (call handler :post (str "/api/rooms/" id "/token")
                           "{}" extra)))))))

(deftest signalling-url-follows-the-request
  ;; Behind TLS the proxy says https and the host it exposes carries /rtc.
  (is (= "wss://quickmeet.absky.dev"
         (signalling-url-for livekit {:server-addr "quickmeet.absky.dev"
                                      :headers {"x-forwarded-proto" "https"}})))
  ;; A plain-http proxy: ws, and the host kept as-is, port included.
  (is (= "ws://meet.example:8080"
         (signalling-url-for livekit {:headers {"x-forwarded-proto" "http"}})))
  ;; An explicit public URL wins over whatever the request says.
  (is (= "wss://sfu.example"
         (signalling-url-for (assoc livekit :public-url "wss://sfu.example")
                             {:headers {"x-forwarded-proto" "https"}})))
  ;; Without :server-addr, the Host header is the fallback.
  (is (= "ws://meet.example:7880"
         (signalling-url-for livekit {:server-addr nil
                                      :headers {"host" "meet.example:8080"}}))))

(deftest presence-and-the-two-person-rule
  ;; The participant lookup is a function the handler is given, so what the
  ;; SFU would say is stubbed here: the real one lives in quickmeet.sfu.
  (let [room-and-token
        (fn [participants]
          (with-handler livekit participants
            (fn [handler _]
              (let [id (new-room handler)]
                {:id id
                 :room (:json (call handler :get (str "/api/rooms/" id)))
                 :token (call handler :post (str "/api/rooms/" id "/token") "{}")}))))]
    ;; Nobody there yet.
    (let [{:keys [room token]} (room-and-token (constantly []))]
      (is (= [] (:participants room)))
      (is (= 200 (:status token))))
    ;; One person: the lookup names them, a second may join.
    (let [{:keys [room token]} (room-and-token (constantly [{:identity "guest:ab12" :name "alice"}]))]
      (is (= [{:identity "guest:ab12" :name "alice"}] (:participants room)))
      (is (= 200 (:status token))))
    ;; Two people: full.
    (let [{:keys [room token]} (room-and-token (constantly [{:identity "alice"}
                                                            {:identity "bob"}]))]
      (is (= ["alice" "bob"] (mapv :identity (:participants room))))
      (is (= 409 (:status token)))
      (is (= {:error "full"} (:json token))))
    ;; The SFU could not be asked: unknown is not full. The SFU's own cap
    ;; still holds.
    (let [{:keys [room token]} (room-and-token (constantly nil))]
      (is (= [] (:participants room)))
      (is (= 200 (:status token))))
    ;; The lookup is asked about the room by id, once per request.
    (let [asked (atom [])
          {:keys [id]} (room-and-token (fn [room-id] (swap! asked conj room-id) []))]
      (is (= [id id] @asked)))))

(deftest unknown-and-invalid-rooms
  (with-handler
    (fn [handler _]
      (is (= 404 (:status (call handler :get "/api/rooms/000000000000"))))
      (is (= 404 (:status (call handler :post "/api/rooms/000000000000/token" "{}"))))
      (is (= 404 (:status (call handler :post "/api/rooms/not-hex/token" "{}"))))
      (is (= 404 (:status (call handler :get "/room/not-a-room"))))
      (is (= 404 (:status (call handler :get "/nope")))))))

;; let-go's server puts the query string on :uri too; it must not keep a
;; page from being found.
(deftest a-query-string-does-not-change-the-route
  (with-handler
    (fn [handler _]
      (is (= 200 (:status (call handler :get "/?utm_source=x" nil {:query-string "utm_source=x"}))))
      (is (= 200 (:status (call handler :get "/history?page=2" nil {:query-string "page=2"}))))
      (is (= 401 (:status (call handler :get "/api/rooms?page=2" nil {:query-string "page=2"})))))))

(deftest pages-and-static
  (with-handler
    (fn [handler _]
      (let [index (call handler :get "/")]
        (is (= 200 (:status index)))
        (is (= "text/html; charset=utf-8" (get-in index [:headers "Content-Type"])))
        (is (str/includes? (:body index) "New call")))
      (let [id (new-room handler)
            page (call handler :get (str "/room/" id))]
        (is (= 200 (:status page)))
        ;; The client library is vendored and served from the binary.
        (is (str/includes? (:body page) "/static/livekit-client.umd.min.js"))
        (is (str/includes? (:body page) "/static/track-processors.js"))
        (is (not (str/includes? (:body page) "jsdelivr"))))
      ;; A room page is served for any well-formed id: the token endpoint
      ;; is what checks the room exists.
      (is (= 200 (:status (call handler :get "/room/0123456789ab"))))
      (let [css (call handler :get "/static/app.css")]
        (is (= 200 (:status css)))
        (is (= "text/css; charset=utf-8" (get-in css [:headers "Content-Type"]))))
      (let [js (call handler :get "/static/livekit-client.umd.min.js")]
        (is (= 200 (:status js)))
        (is (= "text/javascript; charset=utf-8" (get-in js [:headers "Content-Type"])))
        (is (str/includes? (:body js) "livekit-client@2.22.3")))
      (is (= 404 (:status (call handler :get "/static/nope.js"))))
      ;; The account pages, the script they share, and history.
      (doseq [page ["/signup" "/signin" "/settings" "/history" "/static/account.js"]]
        (is (= 200 (:status (call handler :get page))) page))
      ;; The service worker, at the root: a worker controls only the paths
      ;; under its own file's. Never cached, so a change reaches browsers.
      (let [sw (call handler :get "/sw.js")]
        (is (= 200 (:status sw)))
        (is (= "text/javascript; charset=utf-8" (get-in sw [:headers "Content-Type"])))
        (is (= "no-cache" (get-in sw [:headers "Cache-Control"])))
        (is (str/includes? (:body sw) "notificationclick"))))))

;; Background blur: the bundle names where its wasm and model live, and
;; that path is the one the server answers, with a year's cache. The model
;; arriving byte for byte is also the proof that binaries survive io/slurp.
(def ^:private blur-base "/static/blur/tp0.8.1-tv0.10.14")

(deftest the-blur-assets
  (with-handler
    (fn [handler _]
      (let [js (call handler :get "/static/track-processors.js")]
        (is (= 200 (:status js)))
        (is (= "text/javascript; charset=utf-8" (get-in js [:headers "Content-Type"])))
        (is (str/includes? (:body js) blur-base))
        ;; Bundled with scripts/vendor-blur.patch: the averaging downsample
        ;; and the mask smoothing are there. Stock, the blur ripples.
        (is (str/includes? (:body js) "u_srcTexel"))
        (is (str/includes? (:body js) "u_keep")))
      (let [wasm (call handler :get (str blur-base "/vision_wasm_internal.wasm"))]
        (is (= 200 (:status wasm)))
        (is (= "application/wasm" (get-in wasm [:headers "Content-Type"])))
        (is (= "public, max-age=31536000, immutable" (get-in wasm [:headers "Cache-Control"]))))
      (let [model (call handler :get (str blur-base "/selfie_segmenter.tflite"))]
        (is (= 200 (:status model)))
        (is (= "application/octet-stream" (get-in model [:headers "Content-Type"])))
        (is (= "191ac9529ae506ee0beefa6b2c945a172dab9d07d1e802a290a4e4038226658b"
               (hash/sha256 (:body model)))))
      (let [loader (call handler :get (str blur-base "/vision_wasm_internal.js"))]
        (is (= 200 (:status loader)))
        (is (= "text/javascript; charset=utf-8" (get-in loader [:headers "Content-Type"]))))
      ;; Another tag, or a file that is not one of the three: not found.
      (doseq [uri ["/static/blur/some-other-tag/vision_wasm_internal.js"
                   (str blur-base "/app.css")
                   (str blur-base "/nope.wasm")]]
        (is (= 404 (:status (call handler :get uri))) uri)))))

;; Installable to a home screen: the manifest, the icons it names (PNGs,
;; byte for byte: they start with the PNG signature) and the favicon at
;; the path browsers ask for on their own.
(deftest the-installable-app
  (with-handler
    (fn [handler _]
      (let [res (call handler :get "/static/manifest.webmanifest")
            manifest (json/read-json (:body res) {:keywords? true})]
        (is (= 200 (:status res)))
        (is (= "application/manifest+json" (get-in res [:headers "Content-Type"])))
        (is (= "standalone" (:display manifest)))
        (is (= 3 (count (:icons manifest)))))
      (doseq [uri ["/static/icon-192.png" "/static/icon-512.png" "/static/apple-touch-icon.png"]]
        (let [png (call handler :get uri)]
          (is (= 200 (:status png)) uri)
          (is (= "image/png" (get-in png [:headers "Content-Type"])) uri)
          (is (str/starts-with? (io/encode :hex (:body png)) "89504e470d0a1a0a") uri)))
      (let [ico (call handler :get "/favicon.ico")]
        (is (= 200 (:status ico)))
        (is (= "image/x-icon" (get-in ico [:headers "Content-Type"]))))
      ;; Every page links them.
      (doseq [uri ["/" "/signup" "/signin" "/settings" "/history" (str "/room/" (new-room handler))]
              link ["/static/manifest.webmanifest" "/static/apple-touch-icon.png" "href=\"/favicon.ico\""]]
        (is (str/includes? (:body (call handler :get uri)) link) (str uri " " link))))))

(deftest accounts-and-sessions
  (with-handler
    (fn [handler _]
      (let [{:keys [status json cookie] :as res} (signup handler "Alice@Example.com")
            set-cookie (get-in res [:headers "Set-Cookie"])]
        (is (= 201 status))
        (is (= {:email "alice@example.com" :display_name "alice" :language "auto"} json))
        (is (re-find #"^[0-9a-f]{32}$" cookie))
        ;; Plain http: no Secure flag, everything else set.
        (doseq [attr ["Path=/" "HttpOnly" "SameSite=Lax" "Max-Age=31536000"]]
          (is (str/includes? set-cookie attr) attr))
        (is (not (str/includes? set-cookie "Secure")))
        ;; The cookie is the session.
        (is (= 200 (:status (call handler :get "/api/me" nil (as cookie)))))
        (is (= json (:json (call handler :get "/api/me" nil (as cookie)))))
        (is (= 401 (:status (call handler :get "/api/me"))))
        (is (= 401 (:status (call handler :get "/api/me" nil (as "not-a-session")))))
        ;; Renaming.
        (let [renamed (call handler :post "/api/me" "{\"display_name\":\" Alice B. \"}" (as cookie))]
          (is (= 200 (:status renamed)))
          (is (= "Alice B." (:display_name (:json renamed))))
          (is (= "Alice B." (:display_name (:json (call handler :get "/api/me" nil (as cookie)))))))
        (let [bad (call handler :post "/api/me" "{\"display_name\":\"  \"}" (as cookie))]
          (is (= 400 (:status bad)))
          (is (string? (:error (:json bad)))))
        (is (= 401 (:status (call handler :post "/api/me" "{\"display_name\":\"x\"}"))))
        ;; Signing out ends the session and clears the cookie.
        (let [out (call handler :post "/api/auth/signout" nil (as cookie))]
          (is (= 200 (:status out)))
          (is (str/includes? (get-in out [:headers "Set-Cookie"]) "Max-Age=0")))
        (is (= 401 (:status (call handler :get "/api/me" nil (as cookie))))))
      ;; Signing in.
      (let [ok (call handler :post "/api/auth/signin" (json/write-json {:email "alice@example.com" :password "correct horse"}))
            wrong (call handler :post "/api/auth/signin" (json/write-json {:email "alice@example.com" :password "wrong"}))
            nobody (call handler :post "/api/auth/signin" (json/write-json {:email "nobody@example.com" :password "correct horse"}))]
        (is (= 200 (:status ok)))
        (is (= "Alice B." (:display_name (:json ok))))
        (is (= 200 (:status (call handler :get "/api/me" nil (as (cookie-of ok))))))
        (is (= 401 (:status wrong)))
        (is (= {:error "invalid email or password"} (:json wrong)))
        (is (= (:json wrong) (:json nobody))))
      ;; Bad input is 400 with a message; a repeat is 409.
      (let [bad (call handler :post "/api/auth/signup" (json/write-json {:email "no-at" :password "correct horse"}))]
        (is (= 400 (:status bad)))
        (is (str/includes? (:error (:json bad)) "email")))
      (let [short (call handler :post "/api/auth/signup" (json/write-json {:email "b@example.com" :password "short"}))]
        (is (= 400 (:status short)))
        (is (str/includes? (:error (:json short)) "8")))
      (is (= 409 (:status (signup handler "alice@example.com"))))
      (is (= {:error "exists"} (:json (signup handler "ALICE@example.com")))))))

(deftest the-account-language
  ;; Auto (follow the browser) until the person pins English or Russian in
  ;; Settings; the name and the language are saved independently.
  (with-handler
    (fn [handler _]
      (let [{:keys [cookie]} (signup handler "lang@example.com")
            me #(:json (call handler :get "/api/me" nil (as cookie)))
            post #(call handler :post "/api/me" (json/write-json %) (as cookie))]
        (is (= "auto" (:language (me))))
        (let [res (post {:language "ru"})]
          (is (= 200 (:status res)))
          (is (= {:email "lang@example.com" :display_name "lang" :language "ru"} (:json res))))
        (is (= "ru" (:language (me))))
        ;; A name alone leaves the language as it was, and the other way.
        (is (= 200 (:status (post {:display_name "Lang"}))))
        (is (= {:display_name "Lang" :language "ru"} (select-keys (me) [:display_name :language])))
        (is (= 200 (:status (post {:language "en"}))))
        (is (= {:display_name "Lang" :language "en"} (select-keys (me) [:display_name :language])))
        (is (= 200 (:status (post {:display_name "Lang 2" :language "auto"}))))
        (is (= {:display_name "Lang 2" :language "auto"} (select-keys (me) [:display_name :language])))
        ;; Anything else is refused and changes nothing.
        (doseq [body [{:language "de"} {:language ""} {:language 1} {}]]
          (let [res (post body)]
            (is (= 400 (:status res)) (pr-str body))
            (is (string? (:error (:json res))) (pr-str body))))
        (let [res (post {:display_name "Lang 3" :language "de"})]
          (is (= 400 (:status res))))
        (is (= {:display_name "Lang 2" :language "auto"} (select-keys (me) [:display_name :language])))))))

(deftest account-endpoints-take-json-only
  ;; Login CSRF: a cross-site form with enctype text/plain can carry a
  ;; body that parses as JSON, and a sign-in response would then set an
  ;; attacker's session in the victim's browser. A browser cannot send
  ;; application/json cross-site without a preflight this server never
  ;; answers, so requiring it shuts the door.
  (with-handler
    (fn [handler _]
      (let [body (json/write-json {:email "csrf@example.com" :password "correct horse"})
            as-form {:headers {"content-type" "text/plain"}}]
        (doseq [path ["/api/auth/signup" "/api/auth/signin"]]
          (let [res (call handler :post path body as-form)]
            (is (= 415 (:status res)) path)
            (is (nil? (get-in res [:headers "Set-Cookie"])) path)))
        (let [{:keys [cookie]} (signup handler "csrf@example.com")]
          (is (= 415 (:status (call handler :post "/api/me" "{\"display_name\":\"x\"}"
                                    (assoc-in (as cookie) [:headers "content-type"] "text/plain")))))
          ;; With a charset the type still counts.
          (is (= 200 (:status (call handler :post "/api/me" "{\"display_name\":\"x\"}"
                                    (assoc-in (as cookie) [:headers "content-type"] "application/json; charset=utf-8"))))))))))

(deftest the-cookie-is-secure-behind-tls
  (with-handler
    (fn [handler _]
      (let [res (call handler :post "/api/auth/signup"
                      (json/write-json {:email "tls@example.com" :password "correct horse"})
                      {:headers {"x-forwarded-proto" "https"}})]
        (is (= 201 (:status res)))
        (is (str/includes? (get-in res [:headers "Set-Cookie"]) "; Secure"))))))

(deftest creating-a-room-needs-an-account
  (with-handler
    (fn [handler conn]
      (is (= 401 (:status (call handler :post "/api/rooms"))))
      (is (= {:error "unauthorized"} (:json (call handler :post "/api/rooms"))))
      (let [{:keys [cookie json]} (signup handler "owner@example.com")
            created (call handler :post "/api/rooms" nil (as cookie))
            id (:id (:json created))]
        (is (= 201 (:status created)))
        ;; The row remembers who made it; the API does not say.
        (is (= (:id (quickmeet.db/user-by-email conn "owner@example.com"))
               (:owner_id (quickmeet.db/get-room conn id))))
        (is (not (contains? (:json (call handler :get (str "/api/rooms/" id))) :owner_id)))
        ;; A guest with the link needs no account.
        (is (= 200 (:status (call handler :get (str "/api/rooms/" id)))))
        (is (= 200 (:status (call handler :post (str "/api/rooms/" id "/token") "{}"))))
        (is (= 200 (:status (call handler :get (str "/room/" id)))))
        (is (= "owner" (:display_name json)))))))

(deftest the-allowlist
  (let [path (str "/tmp/quickmeet-allow-" (rand-int 100000000) ".db")
        system (ig/init {:quickmeet.db/conn {:path path}})
        conn (:quickmeet.db/conn system)
        handler-for (fn [auth] (routes/handler conn livekit (constantly []) auth (recording-push (atom []))))]
    (try
      (let [only-ok (handler-for {:allowed-emails #{"ok@example.com"}})
            refused (signup only-ok "no@example.com")
            accepted (signup only-ok "OK@example.com")]
        (is (= 403 (:status refused)))
        (is (= {:error "not allowed"} (:json refused)))
        (is (= 201 (:status accepted)))
        (is (= 200 (:status (call only-ok :get "/api/me" nil (as (:cookie accepted))))))
        ;; The operator removes the address: the session is over at its
        ;; next request, and signing in again is refused.
        (let [nobody (handler-for {:allowed-emails #{}})]
          (is (= 401 (:status (call nobody :get "/api/me" nil (as (:cookie accepted))))))
          (is (= 403 (:status (call nobody :post "/api/auth/signin"
                                    (json/write-json {:email "ok@example.com" :password "correct horse"})))))
          (is (= 401 (:status (call nobody :post "/api/rooms" nil (as (:cookie accepted))))))))
      (finally
        (ig/halt! system)
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))

(deftest my-rooms-are-the-ones-I-own-or-joined
  (with-handler livekit (assoc nobody-anywhere :active-rooms (constantly {"000000000000" 2}))
    (fn [handler conn]
      (is (= 401 (:status (call handler :get "/api/rooms"))))
      (let [alice (signup handler "alice@example.com")
            bob (signup handler "bob@example.com")
            first-id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))
            second-id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))]
        (sqlite/execute! conn ["update rooms set created_at = '2026-01-01 00:00:00' where id = ?" first-id])
        ;; Alice owns both, newest first; nobody is in them.
        (let [rooms (listed handler "/api/rooms" (:cookie alice))]
          (is (= [second-id first-id] (mapv :id rooms)))
          (is (= [true true] (mapv :owner rooms)))
          (is (= [0 0] (mapv :present rooms)))
          (is (= [nil nil] (mapv :name rooms))))
        ;; Bob has none until he joins one; a guest's token adds nobody.
        (is (= [] (listed handler "/api/rooms" (:cookie bob))))
        (call handler :post (str "/api/rooms/" first-id "/token") "{}")
        (is (= [] (listed handler "/api/rooms" (:cookie bob))))
        (call handler :post (str "/api/rooms/" first-id "/token") "{}" (as (:cookie bob)))
        (let [rooms (listed handler "/api/rooms" (:cookie bob))]
          (is (= [first-id] (mapv :id rooms)))
          (is (= [false] (mapv :owner rooms))))
        ;; Presence comes from the SFU's active rooms, keyed by id.
        (sqlite/execute! conn ["update rooms set id = '000000000000' where id = ?" second-id])
        (sqlite/execute! conn ["update room_members set room_id = '000000000000' where room_id = ?" second-id])
        (is (= [2 0] (mapv :present (listed handler "/api/rooms" (:cookie alice)))))))))

(deftest only-the-owner-renames-and-deletes
  (with-handler
    (fn [handler _]
      (let [alice (signup handler "alice@example.com")
            bob (signup handler "bob@example.com")
            id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))
            rename (fn [who name] (call handler :post (str "/api/rooms/" id)
                                        (json/write-json {:name name}) (as (:cookie who))))]
        ;; Bob joins, so the room is on his list, but it is not his.
        (call handler :post (str "/api/rooms/" id "/token") "{}" (as (:cookie bob)))
        (is (= 403 (:status (rename bob "Bob's"))))
        (is (= 401 (:status (call handler :post (str "/api/rooms/" id) (json/write-json {:name "x"})))))
        (is (= 415 (:status (call handler :post (str "/api/rooms/" id) "{}"
                                  (merge (as (:cookie alice)) {:headers {"content-type" "text/plain"
                                                                         "cookie" (str "session=" (:cookie alice))}})))))
        (let [res (rename alice "  Mom  ")]
          (is (= 200 (:status res)))
          (is (= "Mom" (:name (:json res))))
          (is (= true (:owner (:json res)))))
        (is (= "Mom" (:name (first (listed handler "/api/rooms" (:cookie alice))))))
        (is (nil? (:name (:json (rename alice "")))))
        (is (= 400 (:status (rename alice (apply str (repeat 65 "x"))))))
        (is (= 404 (:status (call handler :post "/api/rooms/000000000000"
                                  (json/write-json {:name "x"}) (as (:cookie alice))))))
        ;; Delete: the room is gone for everyone, the link says so.
        (is (= 401 (:status (call handler :delete (str "/api/rooms/" id)))))
        (is (= 403 (:status (call handler :delete (str "/api/rooms/" id) nil (as (:cookie bob))))))
        (is (= 200 (:status (call handler :delete (str "/api/rooms/" id) nil (as (:cookie alice))))))
        (is (= 404 (:status (call handler :get (str "/api/rooms/" id)))))
        (is (= [] (listed handler "/api/rooms" (:cookie alice))))
        (is (= [] (listed handler "/api/rooms" (:cookie bob))))
        (is (= 404 (:status (call handler :delete (str "/api/rooms/" id) nil (as (:cookie alice))))))))))

(deftest webhooks-are-verified-and-recorded
  (with-handler
    (fn [handler _]
      (let [alice (signup handler "alice@example.com")
            id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))
            user-id (:identity (:json (call handler :post (str "/api/rooms/" id "/token") "{}" (as (:cookie alice)))))
            event (fn [m] (json/write-json (merge {:room {:name id :sid "RM_1"} :createdAt "1000"} m)))
            joined (event {:event "participant_joined"
                           :participant {:sid "PA_1" :identity user-id :name "Alice" :joinedAt "1000"}})
            guest (event {:event "participant_joined"
                          :participant {:sid "PA_2" :identity "guest:ab12" :name "bob" :joinedAt "1010"}})
            left (event {:event "participant_left" :createdAt "1100"
                         :participant {:sid "PA_2" :identity "guest:ab12" :name "bob"}})
            post (fn [body extra] (call handler :post "/api/webhooks/livekit" body extra))]
        (is (= 401 (:status (call handler :get "/api/calls"))))
        ;; Unsigned, or signed with another secret: refused, nothing kept.
        (is (= 401 (:status (post joined nil))))
        (is (= 401 (:status (post joined (signed-webhook joined "another-secret-another-secret-another!")))))
        ;; The header must match this body, not some other.
        (is (= 401 (:status (post joined (signed-webhook guest)))))
        (is (= [] (listed handler "/api/calls" (:cookie alice))))
        ;; Genuine: recorded, and the call shows up in Alice's history.
        (is (= 200 (:status (post joined (signed-webhook joined)))))
        (is (= 200 (:status (post guest (signed-webhook guest)))))
        (is (= 200 (:status (post left (signed-webhook left)))))
        (let [[call :as calls] (listed handler "/api/calls" (:cookie alice))]
          (is (= 1 (count calls)))
          (is (= id (:room_id call)))
          (is (= "bob" (:with call)))
          (is (nil? (:ended_at call))))))))

;; ---- pages ----------------------------------------------------------------

(defn- page-of
  "A list endpoint's whole answer, as `cookie`'s user, for `query` (nil for
   none)."
  [handler uri cookie query]
  ;; As let-go's server hands it over: the query on the :uri and on its own.
  (:json (call handler :get (cond-> uri query (str "?" query)) nil
               (merge (as cookie) {:query-string query}))))

(deftest rooms-come-a-page-at-a-time
  (with-handler
    (fn [handler conn]
      (let [alice (signup handler "alice@example.com")
            bob (signup handler "bob@example.com")
            ;; 21 rooms, a second apart, oldest first.
            ids (vec (for [i (range 21)]
                       (let [id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))]
                         (sqlite/execute! conn ["update rooms set created_at = datetime(?, 'unixepoch') where id = ?"
                                                (+ 1000 i) id])
                         id)))
            newest-first (vec (reverse ids))
            page (fn [query] (page-of handler "/api/rooms" (:cookie alice) query))
            ids-of (fn [res] (mapv :id (:items res)))]
        (let [first-page (page nil)]
          (is (= (subvec newest-first 0 20) (ids-of first-page)))
          (is (= [1 true] [(:page first-page) (:more first-page)])))
        (is (= {:page 2 :more false} (dissoc (page "page=2") :items)))
        (is (= [(first ids)] (ids-of (page "page=2"))))
        (is (= [(first ids)] (ids-of (page "x=1&page=2"))))
        ;; Past the end: an empty page, not an error.
        (is (= {:items [] :page 3 :more false} (page "page=3")))
        ;; Junk reads as the first page.
        (doseq [query ["page=abc" "page=0" "page=-2" "page=" "pages=2" "x=1"]]
          (is (= 1 (:page (page query))) query)
          (is (= (subvec newest-first 0 20) (ids-of (page query))) query))
        ;; Exactly a page's worth: no older page.
        (call handler :delete (str "/api/rooms/" (first ids)) nil (as (:cookie alice)))
        (is (= [20 false] ((juxt (comp count :items) :more) (page nil))))
        ;; Nobody else's rooms, on any page.
        (is (= {:items [] :page 1 :more false} (page-of handler "/api/rooms" (:cookie bob) nil)))
        (is (= {:items [] :page 2 :more false} (page-of handler "/api/rooms" (:cookie bob) "page=2")))))))

(deftest calls-come-a-page-at-a-time
  (with-handler
    (fn [handler conn]
      (let [alice (signup handler "alice@example.com")
            bob (signup handler "bob@example.com")
            id (:id (:json (call handler :post "/api/rooms" nil (as (:cookie alice)))))
            user-id (:identity (:json (call handler :post (str "/api/rooms/" id "/token") "{}" (as (:cookie alice)))))
            page (fn [query] (page-of handler "/api/calls" (:cookie alice) query))]
        ;; 21 calls in one room, each a new SFU room lifetime 100 s apart,
        ;; so each join closes the call before it.
        (doseq [i (range 21)]
          (let [at (str (+ 1000 (* 100 i)))]
            (history/record! conn {:event "participant_joined"
                                   :room {:name id :sid (str "RM_" i)}
                                   :createdAt at
                                   :participant {:sid (str "PA_" i) :identity user-id
                                                 :name "Alice" :joinedAt at}})))
        (let [first-page (page nil)]
          (is (= 20 (count (:items first-page))))
          (is (= [1 true] [(:page first-page) (:more first-page)]))
          (is (= "1970-01-01 00:50:00" (:started_at (first (:items first-page))))))
        (let [second-page (page "page=2")]
          (is (= ["1970-01-01 00:16:40"] (mapv :started_at (:items second-page))))
          (is (= [2 false] [(:page second-page) (:more second-page)])))
        (is (= {:items [] :page 3 :more false} (page "page=3")))
        (is (= 1 (:page (page "page=zz"))))
        (is (= {:items [] :page 1 :more false} (page-of handler "/api/calls" (:cookie bob) nil)))))))

;; ---- rate limits --------------------------------------------------------

(defn- refusing
  "A stub :limit that refuses `bucket` with a 42 s wait and records every
   question it was asked in `seen`."
  [seen bucket]
  (fn [b key]
    (swap! seen conj [b key])
    (when (= b bucket) 42)))

(defn- limited [seen bucket]
  (assoc anyone :limit (refusing seen bucket)))

(def ^:private credentials
  (json/write-json {:email "someone@example.com" :password "correct horse"}))

(deftest sign-in-and-sign-up-are-limited-by-address
  (doseq [[bucket uri] [[:signin "/api/auth/signin"] [:signup "/api/auth/signup"]]]
    (let [seen (atom [])]
      (with-handler livekit nobody-anywhere (limited seen bucket)
        (fn [handler _]
          (let [res (call handler :post uri credentials {:remote-addr "10.0.0.5:4312"})]
            (is (= 429 (:status res)))
            (is (= "42" (str (get-in res [:headers "Retry-After"]))))
            (is (= "Too many attempts. Try again later." (:error (:json res))))
            (is (= [[bucket "10.0.0.5"]] @seen))))))))

(deftest creating-rooms-is-limited-by-user
  (let [seen (atom [])]
    (with-handler livekit nobody-anywhere (limited seen :create-room)
      (fn [handler conn]
        ;; Without a session it is 401 and the limiter is not asked.
        (is (= 401 (:status (call handler :post "/api/rooms"))))
        (is (not-any? #(= :create-room (first %)) @seen))
        (let [{:keys [cookie]} (signup handler "limited@example.com")
              user-id (:id (sqlite/execute-one! conn ["select id from users where email = ?" "limited@example.com"]))
              res (call handler :post "/api/rooms" nil (as cookie))]
          (is (= 429 (:status res)))
          (is (= "42" (str (get-in res [:headers "Retry-After"]))))
          (is (= [:create-room user-id] (last @seen))))))))

(deftest the-address-a-limit-is-keyed-by
  (doseq [[extra expected] [[{:headers {"x-forwarded-for" "1.1.1.1, 2.2.2.2"} :remote-addr "10.0.0.5:4312"} "2.2.2.2"]
                            [{:headers {"x-forwarded-for" "3.3.3.3"}} "3.3.3.3"]
                            [{:remote-addr "10.0.0.5:4312"} "10.0.0.5"]
                            [{:remote-addr "[::1]:4312"} "::1"]]]
    (let [seen (atom [])]
      (with-handler livekit nobody-anywhere (limited seen :signin)
        (fn [handler _]
          (call handler :post "/api/auth/signin" credentials extra)
          (is (= [[:signin expected]] @seen) (pr-str extra)))))))

(deftest an-allowed-attempt-goes-through
  (let [seen (atom [])]
    (with-handler livekit nobody-anywhere (limited seen :nothing)
      (fn [handler _]
        (is (= 201 (:status (signup handler))))
        (is (= 401 (:status (call handler :post "/api/auth/signin" credentials))))))))

;; ---- ringing ------------------------------------------------------------

(def ^:private fcm "https://fcm.googleapis.com/fcm/send/")

(defn- subscription [endpoint]
  (json/write-json {:endpoint endpoint :keys {:p256dh "BPdh" :auth "au"}}))

(defn- subscribe [handler cookie endpoint]
  (call handler :post "/api/push/subscriptions" (subscription endpoint) (as cookie)))

(defn- user-id [conn email]
  (:id (sqlite/execute-one! conn ["select id from users where email = ?" email])))

(defn- stored [conn]
  (sqlite/query conn ["select endpoint, session_id, p256dh, auth from push_subscriptions order by endpoint"]))

(deftest devices-subscribe-and-unsubscribe
  (with-handler
    (fn [handler conn]
      (is (= {:key "test-public-key"} (:json (call handler :get "/api/push/key"))))
      (let [alice (:cookie (signup handler "alice@example.com"))
            bob (:cookie (signup handler "bob@example.com"))]
        (is (= 401 (:status (subscribe handler nil (str fcm "a")))))
        (is (= 415 (:status (call handler :post "/api/push/subscriptions" (subscription (str fcm "a"))
                                  (assoc-in (as alice) [:headers "content-type"] "text/plain")))))
        (doseq [body [(subscription "https://evil.example/x")
                      (json/write-json {:endpoint (str fcm "a") :keys {:p256dh "" :auth "au"}})
                      (json/write-json {:endpoint (str fcm "a") :keys {:p256dh "BPdh"}})
                      (json/write-json {:endpoint (str fcm "a") :keys {:p256dh (apply str (repeat 257 "a")) :auth "au"}})
                      (json/write-json {:endpoint (str fcm "a")})]]
          (let [res (call handler :post "/api/push/subscriptions" body (as alice))]
            (is (= 400 (:status res)) body)
            (is (string? (:error (:json res))) body)))
        (is (= [] (stored conn)))
        (is (= 200 (:status (subscribe handler alice (str fcm "a")))))
        (is (= 200 (:status (subscribe handler bob (str fcm "b")))))
        (is (= [{:endpoint (str fcm "a") :session_id alice :p256dh "BPdh" :auth "au"}
                {:endpoint (str fcm "b") :session_id bob :p256dh "BPdh" :auth "au"}]
               (stored conn)))
        ;; Unsubscribing takes only one's own device; an unknown one is fine.
        (let [off (fn [cookie endpoint]
                    (call handler :post "/api/push/unsubscribe" (json/write-json {:endpoint endpoint}) (as cookie)))]
          (is (= 401 (:status (off nil (str fcm "a")))))
          (is (= 200 (:status (off alice (str fcm "b")))))
          (is (= 2 (count (stored conn))))
          (is (= 200 (:status (off alice (str fcm "a")))))
          (is (= 200 (:status (off alice (str fcm "nope")))))
          (is (= [(str fcm "b")] (mapv :endpoint (stored conn)))))))))

(defn- token-of [handler id cookie]
  (:json (call handler :post (str "/api/rooms/" id "/token") "{}" (as cookie))))

(defn- ring [handler id cookie & [extra]]
  (call handler :post (str "/api/rooms/" id "/ring") nil (merge-with merge (as cookie) extra)))

(deftest ringing-the-other-members
  (let [present (atom [])
        sent (atom [])]
    (with-handler livekit (fn [_] @present) anyone (recording-push sent)
      (fn [handler conn]
        (let [alice (:cookie (signup handler "alice@example.com"))
              bob (:cookie (signup handler "bob@example.com"))
              carol (:cookie (signup handler "carol@example.com"))
              id (:id (:json (call handler :post "/api/rooms" nil (as alice))))
              alice-in [{:identity (str "user:" (user-id conn "alice@example.com")) :name "alice"}]]
          ;; Bob joins once, which makes him a member; Carol never does.
          (token-of handler id bob)
          (subscribe handler bob (str fcm "bob"))
          (subscribe handler carol (str fcm "carol"))
          (subscribe handler alice (str fcm "alice"))
          ;; The token says whom a ring would reach: the other members with a
          ;; device, by name. A guest rings nobody.
          (is (= ["bob"] (:ring (token-of handler id alice))))
          (is (= ["alice"] (:ring (token-of handler id bob))))
          (is (= [] (:ring (:json (call handler :post (str "/api/rooms/" id "/token") "{}")))))
          ;; Who may ring: someone signed in, in an existing room, in it now.
          (is (= 401 (:status (ring handler id nil))))
          (is (= 404 (:status (ring handler "0123456789ab" alice))))
          (is (= 404 (:status (ring handler "nope" alice))))
          (is (= 403 (:status (ring handler id alice))))
          (is (= [] @sent))
          (reset! present alice-in)
          ;; Bob is not in the room, whatever Alice is.
          (is (= 403 (:status (ring handler id bob))))
          (let [res (ring handler id alice {:headers {"x-forwarded-proto" "https"}})
                [[target message]] @sent
                payload (json/read-json (:payload message) {:keywords? true})]
            (is (= 200 (:status res)))
            (is (= {:devices 1} (:json res)))
            ;; Bob's device only: not Alice's own, not Carol's.
            (is (= 1 (count @sent)))
            (is (= {:endpoint (str fcm "bob") :p256dh "BPdh" :auth "au"}
                   (select-keys target [:endpoint :p256dh :auth])))
            (is (= {:title "alice wants to talk" :body "Tap to join the call."
                    :url (str "/room/" id) :tag (str "room-" id)}
                   payload))
            (is (= id (:topic message)))
            (is (= "https://meet.example:8080" (:subject message))))
          ;; Over plain http (development) the subject is an address.
          (reset! sent [])
          (ring handler id alice)
          (is (= "quickmeet@localhost" (:subject (second (first @sent)))))
          ;; Bob signs out: his device goes with the session, and there is
          ;; nobody left to ring.
          (call handler :post "/api/auth/signout" nil (as bob))
          (is (= [] (:ring (token-of handler id alice))))
          (reset! sent [])
          (let [res (ring handler id alice)]
            (is (= 409 (:status res)))
            (is (= {:error "nobody to ring"} (:json res)))
            (is (= [] @sent))))))))

(deftest a-removed-address-is-not-rung
  (let [present (atom [])
        sent (atom [])]
    (with-handler livekit (fn [_] @present) anyone (recording-push sent)
      (fn [handler conn]
        (let [alice (:cookie (signup handler "alice@example.com"))
              bob (:cookie (signup handler "bob@example.com"))
              id (:id (:json (call handler :post "/api/rooms" nil (as alice))))]
          (token-of handler id bob)
          (subscribe handler bob (str fcm "bob"))
          (reset! present [{:identity (str "user:" (user-id conn "alice@example.com")) :name "alice"}])
          ;; The operator takes Bob's address off the allowlist.
          (let [only-alice (routes/handler conn livekit {:participants (fn [_] @present)
                                                         :active-rooms (constantly {})
                                                         :verify verify}
                                           {:allowed-emails #{"alice@example.com"}}
                                           (recording-push sent))]
            (is (= [] (:ring (token-of only-alice id alice))))
            (is (= 409 (:status (ring only-alice id alice))))
            (is (= [] @sent))))))))

(deftest ringing-is-limited-per-caller-and-room
  (let [seen (atom [])
        present (atom [])]
    (with-handler livekit (fn [_] @present) (limited seen :ring) (recording-push (atom []))
      (fn [handler conn]
        (let [alice (:cookie (signup handler "alice@example.com"))
              bob (:cookie (signup handler "bob@example.com"))
              id (:id (:json (call handler :post "/api/rooms" nil (as alice))))
              alice-id (user-id conn "alice@example.com")]
          ;; Refused before the limit (not in the room, nobody to ring): the
          ;; limiter is not asked, so no window starts.
          (ring handler id alice)
          (reset! present [{:identity (str "user:" alice-id) :name "alice"}])
          (ring handler id alice)
          (is (not-any? #(= :ring (first %)) @seen))
          (token-of handler id bob)
          (subscribe handler bob (str fcm "bob"))
          (let [res (ring handler id alice)]
            (is (= 429 (:status res)))
            (is (= "42" (str (get-in res [:headers "Retry-After"]))))
            (is (= [:ring (str alice-id ":" id)] (last @seen)))))))))
