(ns quickmeet.history-test
  (:require [clojure.test :refer [deftest is]]
            [integrant.core :as ig]
            [quickmeet.db :as db]
            [quickmeet.history :as history]
            [sqlite.core :as sqlite]
            [string :as str]))

;; The webhook state machine over a throwaway database, fed event maps
;; shaped as json/read-json would parse LiveKit's bodies (:keywords? true,
;; times as strings of unix seconds).

(defn- with-db [f]
  (let [path (str "/tmp/quickmeet-history-" (rand-int 100000000) ".db")
        system (ig/init {:quickmeet.db/conn {:path path}})]
    (try
      (f (:quickmeet.db/conn system))
      (finally
        (ig/halt! system)
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))

(def ^:private room "aaaaaaaaaaaa")

(def ^:private room-sid "RM_first")

(defn- joined [sid identity name at]
  {:event "participant_joined" :room {:name room :sid room-sid}
   :participant {:sid sid :identity identity :name name :joinedAt (str at)}
   :createdAt (str at)})

(defn- left [sid at]
  {:event "participant_left" :room {:name room}
   :participant {:sid sid :identity "x" :name "x"} :createdAt (str at)})

(defn- finished [at]
  {:event "room_finished" :room {:name room :sid room-sid} :createdAt (str at)})

(defn- setup [conn]
  (db/create-user! conn "u-alice" "alice@example.com" "x" "Alice")
  (db/create-room! conn room "u-alice"))

(deftest a-call-is-recorded-from-joins-and-leaves
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      ;; Still on: no end, no duration.
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= "bob" (:with call)))
        (is (nil? (:ended_at call)))
        (is (nil? (:seconds call))))
      (history/record! conn (left "PA_2" 1100))
      (history/record! conn (left "PA_1" 1120))
      (history/record! conn (finished 1420))
      (let [calls (history/calls-of-user conn "u-alice")
            call (first calls)]
        (is (= 1 (count calls)))
        (is (= room (:room_id call)))
        (is (= "bob" (:with call)))
        (is (= "1970-01-01 00:16:40" (:started_at call)))
        (is (= "1970-01-01 00:18:40" (:ended_at call)))
        (is (= 120 (:seconds call))))
      ;; The guest has no history to see.
      (is (= [] (history/calls-of-user conn "u-bob"))))))

(deftest redeliveries-and-noise-change-nothing
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (left "PA_1" 1100))
      (history/record! conn (left "PA_1" 1200))
      (history/record! conn (finished 1400))
      ;; Replayed after the call closed: no new call.
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (assoc (joined "PA_9" "user:u-alice" "Alice" 1000) :event "track_published"))
      (history/record! conn (assoc-in (joined "PA_8" "user:u-alice" "Alice" 1000) [:room :name] "000000000000"))
      (let [calls (history/calls-of-user conn "u-alice")]
        (is (= 1 (count calls)))
        (is (= 100 (:seconds (first calls))))
        (is (nil? (:with (first calls))))))))

(deftest room-finished-fills-a-missed-leave
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (history/record! conn (left "PA_2" 1100))
      ;; Alice's leave never arrives; the finish stands in for it.
      (history/record! conn (finished 1400))
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= 400 (:seconds call)))
        (is (= "1970-01-01 00:23:20" (:ended_at call))))
      ;; A later join is a second call.
      (history/record! conn (joined "PA_3" "user:u-alice" "Alice" 2000))
      (is (= 2 (count (history/calls-of-user conn "u-alice")))))))

(deftest events-land-after-the-room-is-deleted
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (db/delete-room! conn room)
      (history/record! conn (left "PA_2" 1100))
      (history/record! conn (finished 1400))
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= "bob" (:with call)))
        (is (= 400 (:seconds call))))
      ;; But nobody can join a room that is gone.
      (history/record! conn (joined "PA_3" "user:u-alice" "Alice" 2000))
      (is (= 1 (count (history/calls-of-user conn "u-alice")))))))

(deftest a-new-room-lifetime-closes-a-stale-call
  ;; The process died mid-call: no leaves, no finish. The SFU's next room
  ;; has a new sid, and its first join ends the old call there and then.
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (history/record! conn (assoc-in (joined "PA_3" "user:u-alice" "Alice" 5000) [:room :sid] "RM_second"))
      (history/record! conn (assoc-in (joined "PA_4" "guest:cd34" "dan" 5010) [:room :sid] "RM_second"))
      (let [[new old] (history/calls-of-user conn "u-alice")]
        (is (= "bob" (:with old)))
        (is (= 4000 (:seconds old)))
        (is (= "dan" (:with new)))
        (is (nil? (:ended_at new))))
      ;; The stale call is closed, so a late finish for it changes nothing.
      (history/record! conn (assoc-in (finished 9000) [:room :sid] "RM_second"))
      (is (= 4000 (:seconds (second (history/calls-of-user conn "u-alice"))))))))

;; ---- calls left open by a process that died ------------------------------

(defn- in-lifetime [event sid]
  (assoc-in event [:room :sid] sid))

(deftest open-calls-are-closed-on-demand
  (with-db
    (fn [conn]
      (setup conn)
      ;; A finished call, then a second meeting still on: one participant
      ;; has left, the other has not.
      (history/record! conn (in-lifetime (joined "PA_0" "user:u-alice" "Alice" 500) "RM_old"))
      (history/record! conn (left "PA_0" 600))
      (history/record! conn (in-lifetime (finished 900) "RM_old"))
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (history/record! conn (left "PA_2" 1100))
      (db/close-open-calls! conn)
      (let [calls (sqlite/query conn ["select sid, ended_at from calls order by sid"])
            people (into {} (map (juxt :sid :left_at))
                         (sqlite/query conn ["select sid, left_at from call_participants"]))]
        (is (= "1970-01-01 00:15:00" (:ended_at (first (filter #(= "RM_old" (:sid %)) calls))))
            "a closed call is untouched")
        (is (some? (:ended_at (first (filter #(= room-sid (:sid %)) calls)))) "the open call is closed")
        (is (nil? (db/open-call conn room)))
        (is (= "1970-01-01 00:10:00" (people "PA_0")))
        (is (= "1970-01-01 00:18:20" (people "PA_2")) "an earlier leave is kept")
        (is (some? (people "PA_1")) "a missing leave is filled in")
        (is (not (str/starts-with? (people "PA_1") "1970")) "with the time of closing")))))

(deftest a-restart-closes-calls-left-open
  (let [path (str "/tmp/quickmeet-history-" (rand-int 100000000) ".db")
        start #(ig/init {:quickmeet.db/conn {:path path}})]
    (try
      (let [system (start)
            conn (:quickmeet.db/conn system)]
        (setup conn)
        (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
        (is (some? (db/open-call conn room)))
        (ig/halt! system))
      (let [system (start)]
        (is (nil? (db/open-call (:quickmeet.db/conn system) room)))
        (ig/halt! system))
      (finally
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))
