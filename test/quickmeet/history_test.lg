(ns quickmeet.history-test
  (:require [clojure.test :refer [deftest is]]
            [integrant.core :as ig]
            [quickmeet.db :as db]
            [quickmeet.history :as history]))

;; The webhook state machine over a throwaway database, fed event maps
;; shaped as json/read-json would parse LiveKit's bodies (:keywords? true,
;; times as strings of unix seconds).

(defn- with-db [f]
  (let [path (str "/tmp/quickmeet-history-" (rand-int 100000000) ".db")
        system (ig/init {:quickmeet.db/conn {:path path}})]
    (try
      (f (:quickmeet.db/conn system))
      (finally
        (ig/halt! system)
        (os/sh "rm" "-f" path (str path "-wal") (str path "-shm"))))))

(def ^:private room "aaaaaaaaaaaa")

(defn- joined [sid identity name at]
  {:event "participant_joined" :room {:name room}
   :participant {:sid sid :identity identity :name name :joinedAt (str at)}
   :createdAt (str at)})

(defn- left [sid at]
  {:event "participant_left" :room {:name room}
   :participant {:sid sid :identity "x" :name "x"} :createdAt (str at)})

(defn- finished [at]
  {:event "room_finished" :room {:name room} :createdAt (str at)})

(defn- setup [conn]
  (db/create-user! conn "u-alice" "alice@example.com" "x" "Alice")
  (db/create-room! conn room "u-alice"))

(deftest a-call-is-recorded-from-joins-and-leaves
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      ;; Still on: no end, no duration.
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= "bob" (:with call)))
        (is (nil? (:ended_at call)))
        (is (nil? (:seconds call))))
      (history/record! conn (left "PA_2" 1100))
      (history/record! conn (left "PA_1" 1120))
      (history/record! conn (finished 1420))
      (let [calls (history/calls-of-user conn "u-alice")
            call (first calls)]
        (is (= 1 (count calls)))
        (is (= room (:room_id call)))
        (is (= "bob" (:with call)))
        (is (= "1970-01-01 00:16:40" (:started_at call)))
        (is (= "1970-01-01 00:18:40" (:ended_at call)))
        (is (= 120 (:seconds call))))
      ;; The guest has no history to see.
      (is (= [] (history/calls-of-user conn "u-bob"))))))

(deftest redeliveries-and-noise-change-nothing
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (left "PA_1" 1100))
      (history/record! conn (left "PA_1" 1200))
      (history/record! conn (finished 1400))
      ;; Replayed after the call closed: no new call.
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (assoc (joined "PA_9" "user:u-alice" "Alice" 1000) :event "track_published"))
      (history/record! conn (assoc-in (joined "PA_8" "user:u-alice" "Alice" 1000) [:room :name] "000000000000"))
      (let [calls (history/calls-of-user conn "u-alice")]
        (is (= 1 (count calls)))
        (is (= 100 (:seconds (first calls))))
        (is (nil? (:with (first calls))))))))

(deftest room-finished-fills-a-missed-leave
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (history/record! conn (left "PA_2" 1100))
      ;; Alice's leave never arrives; the finish stands in for it.
      (history/record! conn (finished 1400))
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= 400 (:seconds call)))
        (is (= "1970-01-01 00:23:20" (:ended_at call))))
      ;; A later join is a second call.
      (history/record! conn (joined "PA_3" "user:u-alice" "Alice" 2000))
      (is (= 2 (count (history/calls-of-user conn "u-alice")))))))

(deftest events-land-after-the-room-is-deleted
  (with-db
    (fn [conn]
      (setup conn)
      (history/record! conn (joined "PA_1" "user:u-alice" "Alice" 1000))
      (history/record! conn (joined "PA_2" "guest:ab12" "bob" 1010))
      (db/delete-room! conn room)
      (history/record! conn (left "PA_2" 1100))
      (history/record! conn (finished 1400))
      (let [[call] (history/calls-of-user conn "u-alice")]
        (is (= "bob" (:with call)))
        (is (= 400 (:seconds call))))
      ;; But nobody can join a room that is gone.
      (history/record! conn (joined "PA_3" "user:u-alice" "Alice" 2000))
      (is (= 1 (count (history/calls-of-user conn "u-alice")))))))
