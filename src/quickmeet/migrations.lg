(ns quickmeet.migrations
  (:require [honey.sql :as sql]
            [ragtime.letgo :as rt]))

;; Schema history as ragtime migrations whose up and down steps are HoneySQL
;; DDL maps. The letgo-packages ragtime package supplies the DataStore (a
;; ragtime_migrations table) and the Migration record; this namespace holds
;; only the app's own history. Append, never edit, once a migration shipped.

;; A step is a HoneySQL map, or a SQL string for what HoneySQL under let-go
;; cannot render (an INSERT ... SELECT comes out with the clauses reordered).
(defn- statement [step]
  (if (string? step) [step] (sql/format step)))

(defn- migration [id up down]
  (rt/sql-migration {:id id
                     :up (mapv statement up)
                     :down (mapv statement down)}))

(def migrations
  [(migration "001-create-rooms"
              [{:create-table :rooms
                :with-columns [[:id :text [:primary-key]]
                               [:created_at :text [:not nil]
                                [:default [:raw "CURRENT_TIMESTAMP"]]]]}]
              [{:drop-table :rooms}])

   ;; Accounts (M3): users and their sessions; a room remembers who made it.
   ;; The column is nullable so rooms from before M3 keep working.
   (migration "002-create-users"
              [{:create-table :users
                :with-columns [[:id :text [:primary-key]]
                               [:email :text [:not nil] [:unique]]
                               [:password_hash :text [:not nil]]
                               [:display_name :text [:not nil]]
                               [:created_at :text [:not nil]
                                [:default [:raw "CURRENT_TIMESTAMP"]]]]}
               {:create-table :sessions
                :with-columns [[:id :text [:primary-key]]
                               [:user_id :text [:not nil] [:references :users :id]]
                               [:created_at :text [:not nil]
                                [:default [:raw "CURRENT_TIMESTAMP"]]]]}
               {:alter-table :rooms
                :add-column [:owner_id :text [:references :users :id]]}]
              [{:alter-table :rooms :drop-column :owner_id}
               {:drop-table :sessions}
               {:drop-table :users}])

   ;; Rooms first (M4): a room gets a name, its members are the signed-in
   ;; people who own or joined it, and history is the calls the SFU
   ;; reported for it. Every owner so far becomes a member, so rooms from
   ;; before M4 show up in their owner's list.
   (migration "003-rooms-members-calls"
              [{:alter-table :rooms
                :add-column [:name :text]}
               {:create-table :room_members
                :with-columns [[:room_id :text [:not nil] [:references :rooms :id]]
                               [:user_id :text [:not nil] [:references :users :id]]
                               [:created_at :text [:not nil]
                                [:default [:raw "CURRENT_TIMESTAMP"]]]
                               [[:primary-key :room_id :user_id]]]}
               {:create-table :calls
                :with-columns [[:id :text [:primary-key]]
                               [:room_id :text [:not nil]]
                               [:sid :text [:not nil]]
                               [:ended_at :text]]}
               {:create-table :call_participants
                :with-columns [[:sid :text [:primary-key]]
                               [:call_id :text [:not nil] [:references :calls :id]]
                               [:user_id :text [:references :users :id]]
                               [:name :text [:not nil]]
                               [:joined_at :text [:not nil]]
                               [:left_at :text]]}
               "INSERT INTO room_members (room_id, user_id)
                SELECT id, owner_id FROM rooms WHERE owner_id IS NOT NULL"]
              [{:drop-table :call_participants}
               {:drop-table :calls}
               {:drop-table :room_members}
               {:alter-table :rooms :drop-column :name}])

   ;; Ringing: each device's push subscription, tied to the session that
   ;; made it so signing out stops that device, and a settings table whose
   ;; first row is the app's VAPID key pair (quickmeet.push).
   (migration "004-push"
              [{:create-table :settings
                :with-columns [[:key :text [:primary-key]]
                               [:value :text [:not nil]]]}
               {:create-table :push_subscriptions
                :with-columns [[:endpoint :text [:primary-key]]
                               [:session_id :text [:not nil] [:references :sessions :id]]
                               [:p256dh :text [:not nil]]
                               [:auth :text [:not nil]]
                               [:created_at :text [:not nil]
                                [:default [:raw "CURRENT_TIMESTAMP"]]]]}]
              [{:drop-table :push_subscriptions}
               {:drop-table :settings}])])

(defn store
  "The ragtime DataStore over `conn`."
  [conn]
  (rt/sql-database conn))

(defn- config [conn]
  {:datastore (store conn)
   :migrations migrations})

(defn migrate!
  "Apply every migration not yet applied, in order."
  [conn]
  (rt/migrate (config conn)))

(defn rollback!
  "Roll back the last migration, or the last `n`."
  ([conn] (rollback! conn 1))
  ([conn n]
   (rt/rollback (config conn) n)))
