(ns quickmeet.sfu
  (:require [http :as http]
            [json :as json]
            [livekit.core :as lk]))

;; Questions the app asks the embedded SFU about live rooms. The livekit
;; package exposes no room API, but the SFU's twirp room service accepts
;; JSON over its own http port, and lk/token mints the admin grant it wants.
;;
;; Why the app asks at all: the SFU enforces room.max_participants itself,
;; but a refused join reaches the browser as a plain 500 on the signalling
;; upgrade, and /rtc/validate (what livekit-client then consults) does not
;; consider the cap and still answers "success". So the browser cannot
;; tell "full" from "broken". The token endpoint asks here first and
;; answers 409 with a message, and the lobby shows who is already there.

(defn- room-service-url [port method]
  ;; The SFU may bind 0.0.0.0 in a container; loopback still reaches it.
  (str "http://127.0.0.1:" port "/twirp/livekit.RoomService/" method))

;; One twirp call: the JSON response for a 200, `not-found` for a 404,
;; nil for anything else including a refused connection.
(defn- room-service [{:keys [api-key api-secret port]} method grant body]
  (try
    (let [token (lk/token api-key api-secret (assoc grant :ttl-seconds 60))
          res (http/post (room-service-url port method)
                         (json/write-json body)
                         {:content-type "application/json"
                          :headers {"Authorization" (str "Bearer " token)}})]
      (case (:status res)
        200 (json/read-json (:body res) {:keywords? true})
        404 :not-found
        nil))
    (catch Exception _ nil)))

(defn participants
  "Who the SFU has in `room-id` now: a vector of {:identity .. :name ..},
   [] when the SFU has no such room (it creates rooms on first join, so an
   app room nobody joined yet is unknown to it), nil when it could not be
   asked. `livekit` is the handler's {:api-key :api-secret :port} map."
  [livekit room-id]
  (let [res (room-service livekit "ListParticipants"
                          {:room room-id :room-admin true} {:room room-id})]
    (cond
      (= :not-found res) []
      (map? res) (->> (:participants res)
                      (remove #(= "DISCONNECTED" (:state %)))
                      (mapv #(select-keys % [:identity :name])))
      :else nil)))

(defn active-rooms
  "The rooms the SFU has right now, as a map of room id to how many are in
   it: {} when none, nil when it could not be asked. Rooms the SFU does
   not know are simply absent. The twirp API keeps protobuf field names
   (num_participants), unlike the webhooks, which are camelCase."
  [livekit]
  (let [res (room-service livekit "ListRooms" {:room-list true} {})]
    (when (map? res)
      (into {} (map (fn [r] [(:name r) (or (:num_participants r) 0)])
                    (:rooms res))))))

(defn create-room!
  "Ask the SFU to create `room-id` now rather than on first join. Tests use
   it to see a room from the SFU's side; the app never needs to."
  [livekit room-id]
  (room-service livekit "CreateRoom" {:room-create true} {:name room-id}))
