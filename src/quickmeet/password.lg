(ns quickmeet.password
  (:refer-clojure :exclude [hash])
  (:require [bcrypt :as bcrypt]))

;; Password hashing, the only place that names bcrypt. The generated
;; namespace wraps golang.org/x/crypto/bcrypt: a let-go string goes in as
;; []byte, a hash comes back as a string.

;; bcrypt's default. About 60 ms per hash on the staging box; enough for a
;; personal instance without making sign-in feel slow.
(def ^:private cost 10)

(defn hash
  "The bcrypt hash of `password`, salted, as a string."
  [password]
  (bcrypt/GenerateFromPassword password cost))

(defn check
  "True when `password` is the one `hash` was made from. A mismatch, or a
   string that is not a bcrypt hash, comes back from Go as an error value
   rather than an exception: nil means a match."
  [hash password]
  (nil? (bcrypt/CompareHashAndPassword hash password)))
