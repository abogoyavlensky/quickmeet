(ns quickmeet.routes
  (:require [integrant.core :as ig]
            [json :as json]
            [livekit.core :as lk]
            [quickmeet.auth :as auth]
            [quickmeet.db :as db]
            [quickmeet.history :as history]
            [quickmeet.id :as id]
            [quickmeet.push :as push]
            [quickmeet.ratelimit :as ratelimit]
            [quickmeet.sfu :as sfu]
            [ruuter.core :as r]
            [string :as str]))

;; The HTTP handler: a Ring-style function over the db connection, the
;; LiveKit credentials, the SFU lookups and the auth settings, and the
;; integrant component between them and the server. Tests call `handler`
;; directly over a throwaway database with stubbed lookups; token minting
;; needs only the key and secret, not a running SFU.
;;
;; Who may do what: creating a room takes an account (a session cookie),
;; and only its owner renames or deletes it; the room page, the room lookup
;; and the join token are open to anyone holding a link. The account logic
;; lives in quickmeet.auth; the routes here only turn its results into
;; responses.

(defn- json-response [status data]
  {:status status
   :headers {"Content-Type" "application/json"}
   :body (json/write-json data)})

(def ^:private content-types
  {"html"   "text/html; charset=utf-8"
   "js"     "text/javascript; charset=utf-8"
   "css"    "text/css; charset=utf-8"
   "svg"    "image/svg+xml"
   "png"    "image/png"
   "ico"    "image/x-icon"
   "webmanifest" "application/manifest+json"
   ;; Streaming compilation of the wasm needs its own type.
   "wasm"   "application/wasm"
   "tflite" "application/octet-stream"})

;; The font is 120 kB of base64 that changes only when the pinned version
;; does, and every page links it: browsers keep it for a week.
(def ^:private long-lived #{"fonts.css"})

;; Background blur's wasm (9.4 MB), its loader and its model are cached for
;; a year, so they live under /static/blur/<tag>/, where the tag names the
;; pinned versions and a bump moves them. scripts/vendor-blur.mjs writes the
;; same tag into track-processors.js, which is how the page finds them:
;; change both together. Only the current tag is served, so a page left
;; open across a bump gets a 404 (and no blur) rather than new files under
;; an old URL. (A literal `blur` segment, because ruuter refuses two
;; different param names at one position, and /static/:file is there.)
(def ^:private blur-tag "tp0.8.1-tv0.10.14")
(def ^:private blur-assets
  #{"vision_wasm_internal.js" "vision_wasm_internal.wasm" "selfie_segmenter.tflite"})

(defn- static-response
  "Serve `name` from resources/public, if its type is one of the above.
   io/slurp returns a let-go string, which holds raw bytes, so binaries
   are served intact. io/resource returns nil for a missing name and for
   one that escapes the resource root, so `..` cannot reach outside it.
   `cache-control`, if given, is sent as that header."
  ([name]
   (static-response name (when (long-lived name) "public, max-age=604800")))
  ([name cache-control]
   (let [ct (content-types (last (str/split (str name) #"\.")))
         res (when ct (io/resource (str "public/" name)))]
     (if res
       {:status 200
        :headers (cond-> {"Content-Type" ct}
                   cache-control (assoc "Cache-Control" cache-control))
        :body (io/slurp res)}
       (json-response 404 {:error "not found"})))))

;; Room ids are short, URL-safe and unguessable enough for a link that is
;; shared on purpose: 12 hex chars of a random UUID.
(defn new-room-id []
  (subs (id/random-hex) 0 12))

(defn- valid-room-id? [id]
  (some? (re-find #"^[0-9a-f]{12}$" (str id))))

(defn- read-json-body [req]
  (let [body (:body req)]
    (when-not (str/blank? (str body))
      (json/read-json body {:keywords? true}))))

(defn- request-host
  "The host the request was addressed to, port included. Go's server moves
   the Host header out of the header map; let-go hands it over as
   :server-addr."
  [req]
  (let [addr (:server-addr req)]
    (if (str/blank? addr) (get-in req [:headers "host"]) addr)))

(defn- signalling-url
  "Where the browser connects for signalling. An explicit :public-url wins.
   Behind a proxy, x-forwarded-proto says whether the page came over TLS,
   and the host the proxy exposes is where /rtc lives: the proxy routes it
   to the SFU, so no port is added. With no proxy, the host the page was
   served from, at the SFU's port."
  [req {:keys [port public-url]}]
  (let [host (request-host req)
        proto (get-in req [:headers "x-forwarded-proto"])]
    (cond
      (not (str/blank? public-url)) public-url

      proto (str (if (= "https" proto) "wss" "ws") "://" host)

      :else
      (str "ws://" (or (some-> host (str/split ":") first) "127.0.0.1")
           ":" port))))

;; ---- accounts -----------------------------------------------------------

(defn- session-id [req]
  (get (auth/parse-cookies (get-in req [:headers "cookie"])) auth/cookie-name))

(defn- secure?
  "Whether the request came over TLS, which is where a Secure cookie
   belongs. Only a proxy says so; direct http is development."
  [req]
  (= "https" (get-in req [:headers "x-forwarded-proto"])))

(defn- with-cookie [response value]
  (assoc-in response [:headers "Set-Cookie"] value))

;; The account endpoints take JSON and nothing else. An html form cannot
;; send application/json, and a cross-site fetch with it needs a preflight
;; this server never answers, so the check keeps another site from posting
;; a sign-in (and its cookie) into a visitor's browser: login CSRF.
(defn- json-request? [req]
  (str/starts-with? (str (get-in req [:headers "content-type"])) "application/json"))

(def ^:private unsupported-media
  (json-response 415 {:error "expected application/json"}))

(defn- json-only [handle]
  (fn [req]
    (if (json-request? req) (handle req) unsupported-media)))

;; ---- rate limits --------------------------------------------------------

(defn client-ip
  "The address a request came from, as the rate limits key it. Behind a
   proxy, the last entry of x-forwarded-for: the one the nearest proxy
   appended, which a client cannot choose. Otherwise the connection's own
   address without its port. A client that reaches the app port directly
   can forge the header, so a deployment keeps that port closed
   (docs/INSTALL.md)."
  [req]
  (let [forwarded (get-in req [:headers "x-forwarded-for"])]
    (if-not (str/blank? forwarded)
      (str/trim (last (str/split forwarded ",")))
      (let [addr (str (:remote-addr req))]
        (or (second (re-matches #"\[(.*)\]:\d+" addr))
            (second (re-matches #"([^:]+):\d+" addr))
            addr)))))

(defn- too-many [retry-after]
  (assoc-in (json-response 429 {:error "Too many attempts. Try again later."})
            [:headers "Retry-After"] (str retry-after)))

(defn- limited
  "Ask the limiter in `auth` about `bucket` and `key`: nil to go ahead, or
   the 429 to answer with. No :limit means no limits."
  [{:keys [limit]} bucket key]
  (when limit
    (when-let [retry (limit bucket key)]
      (too-many retry))))

(defn- public-user [user]
  (select-keys user [:email :display_name :language]))

(def ^:private unauthorized
  (json-response 401 {:error "unauthorized"}))

(def ^:private forbidden
  (json-response 403 {:error "forbidden"}))

(def ^:private room-not-found
  (json-response 404 {:error "not found"}))

(def ^:private error-responses
  {:not-allowed (json-response 403 {:error "not allowed"})
   :exists (json-response 409 {:error "exists"})
   :invalid (json-response 401 {:error "invalid email or password"})})

(defn- error-response [{:keys [error message]}]
  (or (error-responses error)
      (json-response 400 {:error message})))

;; A sign-up or sign-in result as a response: the user, with the session in
;; a cookie, or the error mapped to its status.
(defn- session-response [req status result]
  (if (:error result)
    (error-response result)
    (with-cookie (json-response status (public-user (:user result)))
      (auth/session-cookie (:session result) (secure? req)))))

(defn- clean-name [s]
  (let [s (str/trim (str s))]
    (cond
      (str/blank? s) (str "guest-" (subs (new-room-id) 0 4))
      (> (count s) 64) (subs s 0 64)
      :else s)))

;; Who a participant is to the SFU, and to history. The identity must be
;; unique in the room (LiveKit evicts the earlier holder of a repeated
;; one), so it is the account's id or a random tag, never the typed name;
;; the name is what people see. history.lg reads the user id back out.
(defn- participant-identity [user typed-name]
  (if user
    {:identity (str "user:" (:id user)) :name (:display_name user)}
    {:identity (str "guest:" (subs (id/random-hex) 0 4)) :name (clean-name typed-name)}))

;; ---- pages --------------------------------------------------------------

;; The lists (my rooms, my calls) come a page at a time, newest first. The
;; size is the server's; a client asks only for ?page=N, from 1.
(def ^:private page-size 20)

(defn- page-of
  "The page a request asks for. Missing, malformed or 0 is the first: a
   list has no reason to refuse one."
  [req]
  (let [n (some-> (re-find #"(?:^|&)page=(\d{1,6})(?:&|$)" (str (:query-string req)))
                  second
                  parse-long)]
    (if (and n (pos? n)) n 1)))

(defn- paged
  "One page of a list as {:items [..] :page n :more bool}. `fetch` is
   (fn [limit offset]) -> rows; it is asked for one row more than a page,
   and getting it back is how `more` knows an older page exists."
  [req fetch]
  (let [page (page-of req)
        rows (fetch (inc page-size) (* (dec page) page-size))]
    {:items (vec (take page-size rows))
     :page page
     :more (> (count rows) page-size)}))

(defn- room-name-problem [name]
  (when (> (count name) 64) "The name must be at most 64 characters."))

(defn- public-room [room user active]
  {:id (:id room)
   :name (:name room)
   :created_at (:created_at room)
   :owner (= (:owner_id room) (:id user))
   :present (get active (:id room) 0)})

;; ---- ringing ------------------------------------------------------------

;; A subscription as the browser's PushSubscription.toJSON() gives it:
;; {"endpoint", "keys": {"p256dh", "auth"}}. The endpoint must be a browser
;; vendor's push service (push/endpoint-problem); the keys are short
;; base64url strings.
(defn- subscription-problem [{:keys [endpoint] :as body}]
  (let [{:keys [p256dh auth]} (get body :keys)
        key-ok? #(and (string? %) (not (str/blank? %)) (<= (count %) 256))]
    (cond
      (not (string? endpoint)) "The endpoint is missing."
      (push/endpoint-problem endpoint) (push/endpoint-problem endpoint)
      (not (and (key-ok? p256dh) (key-ok? auth))) "The subscription's keys are missing or malformed."
      :else nil)))

(defn- ring-targets
  "The devices a ring by `user` in the room reaches: the other members'
   live subscriptions, whose address is still allowed."
  [conn auth room-id user]
  (filterv #(auth/allowed? auth (:email %)) (db/ring-targets conn room-id (:id user))))

(defn- ring-names
  "Whom a ring by `user` would reach, by name; [] for a guest."
  [conn auth room-id user]
  (if user
    (vec (distinct (map :display_name (ring-targets conn auth room-id user))))
    []))

(defn- in-room?
  "Whether `user` is in the room now, as the SFU sees it. A lookup that
   could not ask the SFU reads as no."
  [participants room-id user]
  (let [identity (:identity (participant-identity user nil))]
    (boolean (some #(= identity (:identity %)) (participants room-id)))))

(defn- ring-message
  "What a ring sends: the notification the service worker shows, the room
   as the topic (so a newer ring replaces one still waiting at the push
   service), and the VAPID subject, the site's own URL behind TLS. Over
   plain http (development) there is no such URL; the library makes the
   address a mailto:."
  [req user room-id]
  {:payload (json/write-json {:title (str (:display_name user) " wants to talk")
                              :body "Tap to join the call."
                              :url (str "/room/" room-id)
                              :tag (str "room-" room-id)})
   :topic room-id
   :subject (if (secure? req) (str "https://" (request-host req)) "quickmeet@localhost")})

(defn- routes [conn {:keys [api-key api-secret] :as livekit}
               {:keys [participants active-rooms verify]} auth push]
  (let [current-user (fn [req] (auth/current-user conn auth (session-id req)))
        ;; An owner's action on a room: 401 without a session, 404 for no
        ;; such room, 403 for someone else's.
        as-owner (fn [req handle]
                   (let [id (-> req :params :id)
                         user (current-user req)
                         room (and (valid-room-id? id) (db/get-room conn id))]
                     (cond
                       (not user) unauthorized
                       (not room) room-not-found
                       (not= (:owner_id room) (:id user)) forbidden
                       :else (handle room))))]
  [{:path "/"
    :method :get
    :response (fn [_] (static-response "index.html"))}

   {:path "/signup"
    :method :get
    :response (fn [_] (static-response "signup.html"))}

   {:path "/signin"
    :method :get
    :response (fn [_] (static-response "signin.html"))}

   {:path "/settings"
    :method :get
    :response (fn [_] (static-response "settings.html"))}

   {:path "/history"
    :method :get
    :response (fn [_] (static-response "history.html"))}

   ;; Browsers ask for this path on their own, whatever a page links.
   {:path "/favicon.ico"
    :method :get
    :response (fn [_] (static-response "favicon.ico"))}

   ;; The service worker that shows rings. At the root because a worker
   ;; controls only the paths under its own file's; never cached, so a
   ;; changed worker reaches browsers at their next visit.
   {:path "/sw.js"
    :method :get
    :response (fn [_] (static-response "sw.js" "no-cache"))}

   ;; Accounts. Body: {"email": "...", "password": "..."}.
   {:path "/api/auth/signup"
    :method :post
    :response (json-only
               (fn [req]
                 (or (limited auth :signup (client-ip req))
                     (let [{:keys [email password]} (read-json-body req)]
                       (session-response req 201 (auth/sign-up! conn auth email password))))))}

   {:path "/api/auth/signin"
    :method :post
    :response (json-only
               (fn [req]
                 (or (limited auth :signin (client-ip req))
                     (let [{:keys [email password]} (read-json-body req)]
                       (session-response req 200 (auth/sign-in! conn auth email password))))))}

   {:path "/api/auth/signout"
    :method :post
    :response (fn [req]
                (auth/sign-out! conn (session-id req))
                (with-cookie (json-response 200 {}) (auth/clear-cookie)))}

   {:path "/api/me"
    :method :get
    :response (fn [req]
                (if-let [user (current-user req)]
                  (json-response 200 (public-user user))
                  unauthorized))}

   ;; Body: {"display_name": "...", "language": "auto" | "en" | "ru"},
   ;; either or both. Both are checked before either is saved, so a bad
   ;; one changes nothing.
   {:path "/api/me"
    :method :post
    :response (json-only
               (fn [req]
                 (if-let [user (current-user req)]
                   (let [body (read-json-body req)
                         ;; JSON that is not an object (1, "x", []) has
                         ;; nothing to change.
                         body (if (map? body) body {})
                         name? (contains? body :display_name)
                         language? (contains? body :language)
                         language (:language body)]
                     (cond
                       (not (or name? language?))
                       (json-response 400 {:error "Nothing to change."})

                       (and language? (auth/language-problem language))
                       (json-response 400 {:error (auth/language-problem language)})

                       :else
                       (let [renamed (if name? (auth/rename! conn (:id user) (:display_name body)) {:user user})]
                         (if (:error renamed)
                           (error-response renamed)
                           (let [result (if language? (auth/set-language! conn (:id user) language) renamed)]
                             (json-response 200 (public-user (:user result))))))))
                   unauthorized)))}

   {:path "/room/:id"
    :method :get
    :response (fn [req]
                (if (valid-room-id? (-> req :params :id))
                  (static-response "room.html")
                  (json-response 404 {:error "not found"})))}

   {:path "/static/:file"
    :method :get
    :response (fn [req] (static-response (-> req :params :file)))}

   {:path "/static/blur/:tag/:file"
    :method :get
    :response (fn [req]
                (let [{:keys [tag file]} (:params req)]
                  (if (and (= blur-tag tag) (blur-assets file))
                    (static-response file "public, max-age=31536000, immutable")
                    (json-response 404 {:error "not found"}))))}

   ;; Create a room and hand back its id; the page turns it into a link.
   ;; Starting a call takes an account; the room remembers who made it.
   {:path "/api/rooms"
    :method :post
    :response (fn [req]
                (if-let [user (current-user req)]
                  (or (limited auth :create-room (:id user))
                      (let [room (db/create-room! conn (new-room-id) (:id user))]
                        (json-response 201 {:id (:id room)})))
                  unauthorized))}

   ;; My rooms: a page of the ones I own or have joined, newest first, with
   ;; how many are in each right now (one question to the SFU for all of
   ;; them; if it could not be asked, nobody is).
   {:path "/api/rooms"
    :method :get
    :response (fn [req]
                (if-let [user (current-user req)]
                  (let [active (or (active-rooms) {})
                        result (paged req #(db/rooms-of-user conn (:id user) %1 %2))]
                    (json-response 200 (update result :items
                                               (fn [rooms] (mapv #(public-room % user active) rooms)))))
                  unauthorized))}

   ;; Rename. Body: {"name": "..."}; blank clears the name.
   {:path "/api/rooms/:id"
    :method :post
    :response (json-only
               (fn [req]
                 (as-owner req
                   (fn [room]
                     (let [name (str/trim (str (:name (read-json-body req))))]
                       (if-let [problem (room-name-problem name)]
                         (json-response 400 {:error problem})
                         (let [room (db/rename-room! conn (:id room)
                                                     (when-not (str/blank? name) name))]
                           (json-response 200 (public-room room (current-user req) {})))))))))}

   {:path "/api/rooms/:id"
    :method :delete
    :response (fn [req]
                (as-owner req
                  (fn [room]
                    (db/delete-room! conn (:id room))
                    (json-response 200 {}))))}

   {:path "/api/rooms/:id"
    :method :get
    :response (fn [req]
                (let [id (-> req :params :id)]
                  (if-let [room (and (valid-room-id? id) (db/get-room conn id))]
                    ;; Who is in the room now, so a lobby can show it. A
                    ;; lookup that could not ask the SFU reads as nobody.
                    (json-response 200 (-> room
                                           (dissoc :owner_id)
                                           (assoc :participants (or (participants id) []))))
                    (json-response 404 {:error "not found"}))))}

   ;; A join token for a known room. Body: {"identity": "..."}, the name a
   ;; guest typed (optional; a signed-in person's display name is used).
   ;; Two people per room: a third gets 409 and a message the page can show.
   ;; The SFU enforces the same cap itself (system.lg); this check exists
   ;; because a refusal there is not distinguishable in the browser (sfu.lg).
   {:path "/api/rooms/:id/token"
    :method :post
    :response (fn [req]
                (let [id (-> req :params :id)]
                  (cond
                    (not (and (valid-room-id? id) (db/get-room conn id)))
                    (json-response 404 {:error "not found"})

                    (>= (count (participants id)) 2)
                    (json-response 409 {:error "full"})

                    :else
                    (let [user (current-user req)
                          {:keys [identity name]} (participant-identity user (:identity (read-json-body req)))]
                      ;; Joining as a signed-in person puts the room on
                      ;; their list.
                      (when user (db/add-member! conn id (:id user)))
                      ;; `ring`: whom the call page may offer to ring.
                      (json-response 200
                                     {:ring (ring-names conn auth id user)
                                      :token (lk/token api-key api-secret
                                                       {:identity identity
                                                        :name name
                                                        :room id
                                                        :room-join true
                                                        :ttl-seconds 3600})
                                      :identity identity
                                      :name name
                                      :url (signalling-url req livekit)})))))}

   ;; Ring the room's other members: someone in the room right now, signed
   ;; in, notifies every live device of the others. Checked in this order,
   ;; with the limit last so only a ring that is sent starts its window.
   {:path "/api/rooms/:id/ring"
    :method :post
    :response (fn [req]
                (let [id (-> req :params :id)
                      user (current-user req)]
                  (cond
                    (not user) unauthorized
                    (not (and (valid-room-id? id) (db/get-room conn id))) room-not-found
                    (not (in-room? participants id user)) forbidden
                    :else
                    (let [targets (ring-targets conn auth id user)]
                      (if (empty? targets)
                        (json-response 409 {:error "nobody to ring"})
                        (or (limited auth :ring (str (:id user) ":" id))
                            (do (push/deliver! push conn targets (ring-message req user id))
                                (json-response 200 {:devices (count targets)}))))))))}

   ;; The key a browser subscribes with (applicationServerKey).
   {:path "/api/push/key"
    :method :get
    :response (fn [_] (json-response 200 {:key (:public-key push)}))}

   ;; This device may be rung. Body: the browser's subscription. It belongs
   ;; to the session, so signing out stops it.
   {:path "/api/push/subscriptions"
    :method :post
    :response (json-only
               (fn [req]
                 (if (current-user req)
                   (let [body (read-json-body req)]
                     (if-let [problem (subscription-problem body)]
                       (json-response 400 {:error problem})
                       (let [{:keys [p256dh auth]} (get body :keys)]
                         (db/save-subscription! conn (:endpoint body) (session-id req) p256dh auth)
                         (json-response 200 {}))))
                   unauthorized)))}

   ;; This device may not be rung any more. Body: {"endpoint"}. Only a
   ;; device of one's own goes; an unknown one is no error.
   {:path "/api/push/unsubscribe"
    :method :post
    :response (json-only
               (fn [req]
                 (if-let [user (current-user req)]
                   (do (db/delete-own-subscription! conn (str (:endpoint (read-json-body req))) (:id user))
                       (json-response 200 {}))
                   unauthorized)))}

   ;; A page of my call history, newest first.
   {:path "/api/calls"
    :method :get
    :response (fn [req]
                (if-let [user (current-user req)]
                  (json-response 200 (paged req #(history/calls-of-user conn (:id user) %1 %2)))
                  unauthorized))}

   ;; Where the embedded SFU posts its events (system.lg gives it this
   ;; URL). The request is signed with the app's own API key, checked
   ;; here before anything is read; let-go lowercases header names.
   {:path "/api/webhooks/livekit"
    :method :post
    :response (fn [req]
                (let [body (str (:body req))]
                  (if (verify (get-in req [:headers "authorization"]) body)
                    (do (history/record! conn (json/read-json body {:keywords? true}))
                        (json-response 200 {}))
                    unauthorized)))}

   {:path :not-found
    :response (fn [_] (json-response 404 {:error "not found"}))}]))

(defn handler
  "A Ring-style handler: request map in, response map out. `livekit` is
   {:api-key :api-secret :port :public-url}; :public-url is optional.
   `lookups` are the questions asked of the SFU, as functions so tests can
   stub them: :participants, (fn [room-id]) -> vector of {:identity :name},
   [] for a room nobody is in, nil when the SFU could not be asked;
   :active-rooms, (fn []) -> map of room id to how many are in it, nil when
   it could not be asked; :verify, (fn [authorization-header body]) ->
   whether a webhook is genuinely the SFU's. `auth` is {:allowed-emails
   #{..} | nil, :limit f}: the addresses that may have an account, or nil
   for open sign-up; and, optionally, the rate limiter as (fn [bucket key])
   -> nil to allow, or the seconds to wait (quickmeet.ratelimit/check!).
   Without :limit nothing is limited. `push` is how rings go out:
   {:public-key, :send! (fn [target message]) -> status, :spawn (fn [f])}
   (quickmeet.push/service)."
  [conn livekit lookups auth push]
  (let [table (routes conn livekit lookups auth push)]
    (fn [req]
      ;; let-go's :uri is the request URI, query string included, and
      ;; ruuter matches it whole: routes see the path alone. The query
      ;; stays under :query-string.
      (r/route table (update req :uri #(str/replace (str %) #"\?.*$" ""))))))

;; The real lookups are built from the same :livekit map the routes use, so
;; a system that moves the SFU port (the tests do) asks the right one.
(defmethod ig/init-key ::handler [_ {:keys [db livekit auth rate-limit?]}]
  (let [{:keys [api-key api-secret]} livekit
        auth (cond-> (or auth {:allowed-emails nil})
               rate-limit? (assoc :limit (partial ratelimit/check!
                                                  (ratelimit/limiter ratelimit/default-limits
                                                                     #(System/currentTimeMillis)))))]
    (handler db livekit
             {:participants (partial sfu/participants livekit)
              :active-rooms (partial sfu/active-rooms livekit)
              :verify (fn [header body] (lk/verify-webhook header body api-key api-secret))}
             auth
             (push/service db))))
