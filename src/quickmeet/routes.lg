(ns quickmeet.routes
  (:require [integrant.core :as ig]
            [json :as json]
            [livekit.core :as lk]
            [quickmeet.auth :as auth]
            [quickmeet.db :as db]
            [quickmeet.id :as id]
            [quickmeet.sfu :as sfu]
            [ruuter.core :as r]
            [string :as str]))

;; The HTTP handler: a Ring-style function over the db connection, the
;; LiveKit credentials, a participant lookup and the auth settings, and the
;; integrant component between them and the server. Tests call `handler`
;; directly over a throwaway database with a stubbed lookup; token minting
;; needs only the key and secret, not a running SFU.
;;
;; Who may do what: creating a room takes an account (a session cookie);
;; the room page, the room lookup and the join token are open to anyone
;; holding a link. The account logic lives in quickmeet.auth; the routes
;; here only turn its results into responses.

(defn- json-response [status data]
  {:status status
   :headers {"Content-Type" "application/json"}
   :body (json/write-json data)})

(def ^:private content-types
  {"html" "text/html; charset=utf-8"
   "js"   "text/javascript; charset=utf-8"
   "css"  "text/css; charset=utf-8"
   "svg"  "image/svg+xml"})

(defn- static-response
  "Serve `name` from resources/public. Only the text types above are served:
   io/slurp reads a string, so binaries would not survive. io/resource
   returns nil for a missing name and for one that escapes the resource
   root, so `..` cannot reach outside it."
  [name]
  (let [ct (content-types (last (str/split (str name) #"\.")))
        res (when ct (io/resource (str "public/" name)))]
    (if res
      {:status 200
       :headers {"Content-Type" ct}
       :body (io/slurp res)}
      (json-response 404 {:error "not found"}))))

;; Room ids are short, URL-safe and unguessable enough for a link that is
;; shared on purpose: 12 hex chars of a random UUID.
(defn new-room-id []
  (subs (id/random-hex) 0 12))

(defn- valid-room-id? [id]
  (some? (re-find #"^[0-9a-f]{12}$" (str id))))

(defn- read-json-body [req]
  (let [body (:body req)]
    (when-not (str/blank? (str body))
      (json/read-json body {:keywords? true}))))

(defn- request-host
  "The host the request was addressed to, port included. Go's server moves
   the Host header out of the header map; let-go hands it over as
   :server-addr."
  [req]
  (let [addr (:server-addr req)]
    (if (str/blank? addr) (get-in req [:headers "host"]) addr)))

(defn- signalling-url
  "Where the browser connects for signalling. An explicit :public-url wins.
   Behind a proxy, x-forwarded-proto says whether the page came over TLS,
   and the host the proxy exposes is where /rtc lives: the proxy routes it
   to the SFU, so no port is added. With no proxy, the host the page was
   served from, at the SFU's port."
  [req {:keys [port public-url]}]
  (let [host (request-host req)
        proto (get-in req [:headers "x-forwarded-proto"])]
    (cond
      (not (str/blank? public-url)) public-url

      proto (str (if (= "https" proto) "wss" "ws") "://" host)

      :else
      (str "ws://" (or (some-> host (str/split ":") first) "127.0.0.1")
           ":" port))))

;; ---- accounts -----------------------------------------------------------

(defn- session-id [req]
  (get (auth/parse-cookies (get-in req [:headers "cookie"])) auth/cookie-name))

(defn- secure?
  "Whether the request came over TLS, which is where a Secure cookie
   belongs. Only a proxy says so; direct http is development."
  [req]
  (= "https" (get-in req [:headers "x-forwarded-proto"])))

(defn- with-cookie [response value]
  (assoc-in response [:headers "Set-Cookie"] value))

;; The account endpoints take JSON and nothing else. An html form cannot
;; send application/json, and a cross-site fetch with it needs a preflight
;; this server never answers, so the check keeps another site from posting
;; a sign-in (and its cookie) into a visitor's browser: login CSRF.
(defn- json-request? [req]
  (str/starts-with? (str (get-in req [:headers "content-type"])) "application/json"))

(def ^:private unsupported-media
  (json-response 415 {:error "expected application/json"}))

(defn- json-only [handle]
  (fn [req]
    (if (json-request? req) (handle req) unsupported-media)))

(defn- public-user [user]
  (select-keys user [:email :display_name]))

(def ^:private unauthorized
  (json-response 401 {:error "unauthorized"}))

(def ^:private error-responses
  {:not-allowed (json-response 403 {:error "not allowed"})
   :exists (json-response 409 {:error "exists"})
   :invalid (json-response 401 {:error "invalid email or password"})})

(defn- error-response [{:keys [error message]}]
  (or (error-responses error)
      (json-response 400 {:error message})))

;; A sign-up or sign-in result as a response: the user, with the session in
;; a cookie, or the error mapped to its status.
(defn- session-response [req status result]
  (if (:error result)
    (error-response result)
    (with-cookie (json-response status (public-user (:user result)))
      (auth/session-cookie (:session result) (secure? req)))))

(defn- clean-identity [s]
  (let [s (str/trim (str s))]
    (cond
      (str/blank? s) (str "guest-" (subs (new-room-id) 0 4))
      (> (count s) 64) (subs s 0 64)
      :else s)))

(defn- routes [conn {:keys [api-key api-secret] :as livekit} participants auth]
  (let [current-user (fn [req] (auth/current-user conn auth (session-id req)))]
  [{:path "/"
    :method :get
    :response (fn [_] (static-response "index.html"))}

   {:path "/signup"
    :method :get
    :response (fn [_] (static-response "signup.html"))}

   {:path "/signin"
    :method :get
    :response (fn [_] (static-response "signin.html"))}

   {:path "/settings"
    :method :get
    :response (fn [_] (static-response "settings.html"))}

   ;; Accounts. Body: {"email": "...", "password": "..."}.
   {:path "/api/auth/signup"
    :method :post
    :response (json-only
               (fn [req]
                 (let [{:keys [email password]} (read-json-body req)]
                   (session-response req 201 (auth/sign-up! conn auth email password)))))}

   {:path "/api/auth/signin"
    :method :post
    :response (json-only
               (fn [req]
                 (let [{:keys [email password]} (read-json-body req)]
                   (session-response req 200 (auth/sign-in! conn auth email password)))))}

   {:path "/api/auth/signout"
    :method :post
    :response (fn [req]
                (auth/sign-out! conn (session-id req))
                (with-cookie (json-response 200 {}) (auth/clear-cookie)))}

   {:path "/api/me"
    :method :get
    :response (fn [req]
                (if-let [user (current-user req)]
                  (json-response 200 (public-user user))
                  unauthorized))}

   ;; Body: {"display_name": "..."}.
   {:path "/api/me"
    :method :post
    :response (json-only
               (fn [req]
                 (if-let [user (current-user req)]
                   (let [result (auth/rename! conn (:id user) (:display_name (read-json-body req)))]
                     (if (:error result)
                       (error-response result)
                       (json-response 200 (public-user (:user result)))))
                   unauthorized)))}

   {:path "/room/:id"
    :method :get
    :response (fn [req]
                (if (valid-room-id? (-> req :params :id))
                  (static-response "room.html")
                  (json-response 404 {:error "not found"})))}

   {:path "/static/:file"
    :method :get
    :response (fn [req] (static-response (-> req :params :file)))}

   ;; Create a room and hand back its id; the page turns it into a link.
   ;; Starting a call takes an account; the room remembers who made it.
   {:path "/api/rooms"
    :method :post
    :response (fn [req]
                (if-let [user (current-user req)]
                  (let [room (db/create-room! conn (new-room-id) (:id user))]
                    (json-response 201 {:id (:id room)}))
                  unauthorized))}

   {:path "/api/rooms/:id"
    :method :get
    :response (fn [req]
                (let [id (-> req :params :id)]
                  (if-let [room (and (valid-room-id? id) (db/get-room conn id))]
                    ;; Who is in the room now, so a lobby can show it. A
                    ;; lookup that could not ask the SFU reads as nobody.
                    (json-response 200 (-> room
                                           (dissoc :owner_id)
                                           (assoc :participants (or (participants id) []))))
                    (json-response 404 {:error "not found"}))))}

   ;; A join token for a known room. Body: {"identity": "..."} (optional).
   ;; Two people per room: a third gets 409 and a message the page can show.
   ;; The SFU enforces the same cap itself (system.lg); this check exists
   ;; because a refusal there is not distinguishable in the browser (sfu.lg).
   {:path "/api/rooms/:id/token"
    :method :post
    :response (fn [req]
                (let [id (-> req :params :id)]
                  (cond
                    (not (and (valid-room-id? id) (db/get-room conn id)))
                    (json-response 404 {:error "not found"})

                    (>= (count (participants id)) 2)
                    (json-response 409 {:error "full"})

                    :else
                    (let [identity (clean-identity (:identity (read-json-body req)))]
                      (json-response 200
                                     {:token (lk/token api-key api-secret
                                                       {:identity identity
                                                        :room id
                                                        :room-join true
                                                        :ttl-seconds 3600})
                                      :identity identity
                                      :url (signalling-url req livekit)})))))}

   {:path :not-found
    :response (fn [_] (json-response 404 {:error "not found"}))}]))

(defn handler
  "A Ring-style handler: request map in, response map out. `livekit` is
   {:api-key :api-secret :port :public-url}; :public-url is optional.
   `participants` is (fn [room-id]) -> vector of {:identity ..}, [] for a
   room nobody is in, nil when the SFU could not be asked. `auth` is
   {:allowed-emails #{..} | nil}: the addresses that may have an account,
   or nil for open sign-up."
  [conn livekit participants auth]
  (let [table (routes conn livekit participants auth)]
    (fn [req]
      (r/route table req))))

;; The real lookup is built from the same :livekit map the routes use, so a
;; system that moves the SFU port (the tests do) asks the right one.
(defmethod ig/init-key ::handler [_ {:keys [db livekit auth]}]
  (handler db livekit (partial sfu/participants livekit)
           (or auth {:allowed-emails nil})))
