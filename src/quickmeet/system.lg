(ns quickmeet.system
  (:require [integrant.core :as ig]
            [livekit.integrant]
            [quickmeet.db :as db]
            [quickmeet.routes]
            [quickmeet.server]
            [string :as str]))

;; One config map describes the app; integrant starts the components in
;; dependency order (db and the SFU, then the handler over them, then the
;; http server) and halts them in reverse, so the server stops taking
;; requests before the SFU and the database go away.
;;
;; Everything a deployment changes is an environment variable with a
;; development default. The defaults bind the SFU to loopback with a
;; well-known dev key, which is fine on a laptop and wrong on a server; so
;; the one dangerous combination, that key on an SFU other machines can
;; reach, refuses to start (`check-secret!`). HOST binds the app's own
;; port; empty is every interface (a container behind a proxy needs that),
;; and a single box with its proxy on it sets 127.0.0.1.
;; `config` takes the lookup function so tests can pass a map instead of
;; touching the process environment.
;;
;; Media goes over a UDP port range by default. LIVEKIT_UDP_PORT switches the
;; SFU to one multiplexed UDP port instead, for containers: one published
;; port is all a host-mode mapping needs.
;;
;; ALLOWED_EMAILS, comma-separated, limits who may have an account (sign-up,
;; sign-in, and every request of a live session); unset, sign-up is open.
;;
;; RATE_LIMIT=false switches the rate limits off (quickmeet.ratelimit); the
;; browser suite needs that, since it signs up dozens of accounts from one
;; address. The limits themselves are constants, not configuration.

(defn- env [lookup name default]
  (let [v (lookup name)]
    (if (str/blank? v) default v)))

(defn- env-int [lookup name default]
  (Integer/parseInt (env lookup name (str default))))

(defn- env-bool [lookup name default]
  (= "true" (env lookup name (str default))))

(defn- env-emails
  "A set of normalised addresses from a comma-separated variable, or nil
   when it is unset or blank."
  [lookup name]
  (let [emails (->> (str/split (env lookup name "") ",")
                    (map #(str/lower-case (str/trim %)))
                    (remove str/blank?)
                    set)]
    (when (seq emails) emails)))

(def dev-api-key "devkey")
(def dev-api-secret "quickmeet-dev-secret-change-me-in-production!")

(defn- exposed?
  "Whether the SFU is set up for other machines to reach: bound off
   loopback, advertising a public address, or given a public URL."
  [lookup]
  (or (not (contains? #{"127.0.0.1" "localhost"} (env lookup "LIVEKIT_BIND" "127.0.0.1")))
      (env-bool lookup "LIVEKIT_USE_EXTERNAL_IP" false)
      (some? (env lookup "LIVEKIT_PUBLIC_URL" nil))))

(defn- check-secret!
  "Refuse the development secret on an exposed SFU: with a secret everyone
   knows, anyone can mint join tokens and admin tokens for it."
  [lookup api-secret]
  (when (and (= api-secret dev-api-secret) (exposed? lookup))
    (throw (ex-info (str "LIVEKIT_API_SECRET is the development secret, but the SFU is "
                         "reachable from other machines (LIVEKIT_BIND, LIVEKIT_USE_EXTERNAL_IP "
                         "or LIVEKIT_PUBLIC_URL). Set LIVEKIT_API_SECRET to 32 or more random "
                         "characters, for example: openssl rand -hex 32")
                    {:variable "LIVEKIT_API_SECRET"}))))

;; The SFU posts its webhooks to 127.0.0.1:PORT, so the app must listen
;; there: on every interface, or on IPv4 loopback alone. A specific other
;; address would silently stop call history, so it is refused. "localhost"
;; is refused too: a host that maps it only to ::1 would do the same.
(def ^:private bind-hosts #{"" "0.0.0.0" "127.0.0.1"})

(defn- app-host [lookup]
  (let [host (env lookup "HOST" "")]
    (when-not (contains? bind-hosts host)
      (throw (ex-info (str "HOST must be empty, 0.0.0.0 or 127.0.0.1, not " host
                           ": the SFU delivers its webhooks to 127.0.0.1.")
                      {:variable "HOST"})))
    host))

(defn- rtc-config [lookup]
  (let [udp-port (env lookup "LIVEKIT_UDP_PORT" nil)]
    (merge {:tcp_port (env-int lookup "LIVEKIT_RTC_TCP_PORT" 7881)
            :use_external_ip (env-bool lookup "LIVEKIT_USE_EXTERNAL_IP" false)}
           ;; LiveKit ignores the range when udp_port is set; leaving it out
           ;; makes the mode visible in the logged config.
           (if udp-port
             {:udp_port (Integer/parseInt udp-port)}
             {:port_range_start (env-int lookup "LIVEKIT_UDP_START" 50000)
              :port_range_end (env-int lookup "LIVEKIT_UDP_END" 50100)}))))

(defn config
  ([] (config os/getenv))
  ([lookup]
   (let [api-key (env lookup "LIVEKIT_API_KEY" dev-api-key)
         api-secret (env lookup "LIVEKIT_API_SECRET" dev-api-secret)
         lk-port (env-int lookup "LIVEKIT_PORT" 7880)
         port (env lookup "PORT" "8080")]
     (check-secret! lookup api-secret)
     {:quickmeet.db/conn {:path (env lookup "DB_PATH" "quickmeet.db")}

      :livekit/server
      {:config {:port lk-port
                :bind_addresses [(env lookup "LIVEKIT_BIND" "127.0.0.1")]
                :rtc (rtc-config lookup)
                ;; Two people per room is a product decision (ROADMAP.md).
                ;; The SFU enforces it; the app reports it (routes.lg).
                ;; empty_timeout and departure_timeout keep LiveKit's
                ;; defaults (300 s and 20 s).
                :room {:max_participants 2}
                ;; The SFU reports joins, leaves and finished rooms to
                ;; this app over loopback, which reaches it whatever it
                ;; binds; routes.lg verifies the signature, history.lg
                ;; records the events. The keys are LiveKit's own; its
                ;; parser is strict.
                :webhook {:api_key api-key
                          :urls [(str "http://127.0.0.1:" port "/api/webhooks/livekit")]}
                :keys {api-key api-secret}
                :logging {:level (env lookup "LIVEKIT_LOG_LEVEL" "warn")}}}

      :quickmeet.routes/handler {:db (ig/ref :quickmeet.db/conn)
                                 :livekit {:api-key api-key
                                           :api-secret api-secret
                                           :port lk-port
                                           :public-url (env lookup "LIVEKIT_PUBLIC_URL" nil)}
                                 :auth {:allowed-emails (env-emails lookup "ALLOWED_EMAILS")}
                                 :rate-limit? (env-bool lookup "RATE_LIMIT" true)}

      ;; The server refs the SFU so it never accepts a join before the SFU
      ;; can take the participant.
      :quickmeet.server/http {:addr (str (app-host lookup) ":" port)
                              :handler (ig/ref :quickmeet.routes/handler)
                              :livekit (ig/ref :livekit/server)}})))

(defn start!
  ([] (start! (config)))
  ([config] (ig/init config)))

(defn stop! [system] (ig/halt! system))

;; What SIGTERM does (main.lg). The SFU is deliberately left running until
;; the process exits: halting it gracefully waits for every participant to
;; leave, which never happens during a call, and halting it with force
;; tells every participant to leave, which ends the call. Left alone, it
;; dies with the process, the browsers see a dropped connection and
;; reconnect to the next process by themselves (docs/KNOWLEDGE.md,
;; "Restarts and shutdown"). Signalling is on the SFU's own port, so
;; stopping the app's server does not touch a call.
(defn shutdown!
  "Stop serving and close the database, leaving the SFU up until the
   process exits. Open calls are closed first, at the time of the stop."
  [system]
  ;; http/stop drains in-flight requests for up to 5 s.
  (ig/halt! system [:quickmeet.server/http])
  (db/close-open-calls! (:quickmeet.db/conn system))
  ;; Halting the db also halts its dependents: the handler (nothing to do)
  ;; and the server again, which http/stop allows.
  (ig/halt! system [:quickmeet.db/conn]))
