diff --git a/src/webgl/shader-programs/maskSmoothShader.ts b/src/webgl/shader-programs/maskSmoothShader.ts
new file mode 100644
index 0000000..46c8668
--- /dev/null
+++ b/src/webgl/shader-programs/maskSmoothShader.ts
@@ -0,0 +1,66 @@
+import { createProgram, createShader, glsl } from '../utils';
+import { vertexShaderSource } from './vertexShader';
+
+// The mask, smoothed over time: each new mask is blended with the one
+// before it, so an edge the segmenter places a little differently from
+// frame to frame holds still instead of shimmering. No flip: the previous
+// mask was written by this pass and must line up with the new one.
+export const maskSmoothFragmentShader = glsl`#version 300 es
+  precision highp float;
+  in vec2 texCoords;
+  uniform sampler2D u_current;
+  uniform sampler2D u_previous;
+  uniform float u_keep;
+  out vec4 fragColor;
+
+  void main() {
+    float current = texture(u_current, texCoords).r;
+    float previous = texture(u_previous, texCoords).r;
+    fragColor = vec4(vec3(mix(current, previous, u_keep)), 1.0);
+  }
+`;
+
+export function createMaskSmoothProgram(gl: WebGL2RenderingContext) {
+  const vertexShader = createShader(gl, gl.VERTEX_SHADER, vertexShaderSource(false));
+  const fragmentShader = createShader(gl, gl.FRAGMENT_SHADER, maskSmoothFragmentShader);
+  const program = createProgram(gl, vertexShader, fragmentShader);
+  return {
+    program,
+    vertexShader,
+    fragmentShader,
+    uniforms: {
+      position: gl.getAttribLocation(program, 'position'),
+      current: gl.getUniformLocation(program, 'u_current'),
+      previous: gl.getUniformLocation(program, 'u_previous'),
+      keep: gl.getUniformLocation(program, 'u_keep'),
+    },
+  };
+}
+
+export function applyMaskSmoothing(
+  gl: WebGL2RenderingContext,
+  smooth: ReturnType<typeof createMaskSmoothProgram>,
+  vertexBuffer: WebGLBuffer,
+  current: WebGLTexture,
+  previous: WebGLTexture,
+  keep: number,
+  target: WebGLFramebuffer,
+  width: number,
+  height: number,
+) {
+  gl.useProgram(smooth.program);
+  gl.bindFramebuffer(gl.FRAMEBUFFER, target);
+  gl.viewport(0, 0, width, height);
+  gl.bindBuffer(gl.ARRAY_BUFFER, vertexBuffer);
+  gl.vertexAttribPointer(smooth.uniforms.position, 2, gl.FLOAT, false, 0, 0);
+  gl.enableVertexAttribArray(smooth.uniforms.position);
+  gl.activeTexture(gl.TEXTURE0);
+  gl.bindTexture(gl.TEXTURE_2D, current);
+  gl.uniform1i(smooth.uniforms.current, 0);
+  gl.activeTexture(gl.TEXTURE1);
+  gl.bindTexture(gl.TEXTURE_2D, previous);
+  gl.uniform1i(smooth.uniforms.previous, 1);
+  gl.uniform1f(smooth.uniforms.keep, keep);
+  gl.drawArrays(gl.TRIANGLES, 0, 6);
+  gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+}
